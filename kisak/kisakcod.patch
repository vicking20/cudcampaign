diff --git a/src/server/sv_coop.cpp b/src/server/sv_coop.cpp
new file mode 100644
index 0000000..2636d03
--- /dev/null
+++ b/src/server/sv_coop.cpp
@@ -0,0 +1,1972 @@
+// COOP: live replay streaming (spectator mode).
+//
+// The SP server records every nondeterministic input into sv.demo.msg (the replay system).
+// Host: streams that byte buffer to a guest over TCP after each server frame.
+// Guest: loads the same map, receives the stream and restarts the level in replay mode
+// (the replay_restart path), fast-forwards to the host's time, then follows live.
+// Because the engine is deterministic, the guest's simulation matches the host's exactly.
+//
+//   host : +set coop_host <port>          (e.g. 28970)
+//   guest: +set coop_connect <ip[:port]>  (+map <same map as host>)
+#include <script/scr_const.h>
+#include <winsock2.h>
+#include <windows.h>
+
+#include <universal/q_shared.h>
+#include "server.h"
+#include "sv_public.h"
+#include <game/g_local.h>
+#include <qcommon/cmd.h>
+#include "sv_game.h"
+#include <client/client.h>
+#include <qcommon/threads.h>
+#include <win32/win_local.h>
+#include <game/g_main.h>
+#include <game/game_public.h>
+#include <bgame/bg_local.h>
+#include <game/g_scr_main.h>
+#include <xanim/xanim.h>
+
+#include "coop_names.h"
+
+void SV_DemoRestart(); // sv_demo.cpp
+bool SV_CoopGetDemoSave(const unsigned char **data, int *len); // sv_demo.cpp
+bool SV_CoopSetDemoSave(const unsigned char *data, int len);   // sv_demo.cpp
+extern unsigned int g_coopRecordingGen;                        // sv_demo.cpp
+static unsigned int s_hostRecGen;                              // recording the guest is following
+
+#define COOP_DEFAULT_PORT 28970
+#define COOP_MAGIC 0x504F4F43 // 'COOP'
+#define COOP_MAX_PIECE (16 * 1024)
+#define COOP_MAX_LAG_MS 250    // guest fast-forwards when further behind than this
+#define COOP_TARGET_LAG_MS 100 // ...down to this (must stay > 2 frames)
+#define COOP_MAP_NAME 64
+#define COOP_RESET_PREFIX (COOP_MAP_NAME + 12) // reset payload = map name, this guest's player slot (int), kind (int), the host's callsign (int), then:
+#define COOP_RESET_START 0    // kind 0: the savegame the host's recording started from (replay from the start)
+#define COOP_RESET_SNAPSHOT 1 // kind 1: a CoopSnapHeader + three blobs: the game as it is now (late join)
+
+struct CoopSnapSlot
+{
+    int active;
+    int name;
+    usercmd_s lastUsercmd; // the replay decodes each player's input as a delta from the previous one
+};
+struct CoopSnapHeader
+{
+    int time, randomSeed, nextFramePos, msgBit, msgReadcount, readType;
+    int saveLen, cmLen, freeLen;
+    int bodyEnt; // entity drawn as player 0's body
+    usercmd_s lastUsercmd;
+    CoopSnapSlot slots[COOP_MAX_CLIENTS];
+};
+#define COOP_FRAME_PENDING (-0x7FFFFFFF) // piece is not the end of a frame
+#define COOP_FRAME_RESET (-0x7FFFFFFE)   // piece of a new recording's start savegame (offset/len within
+                                         // the save, hostTime = total size); what follows is the new recording
+#define COOP_CMD_MAGIC 0x31444D43 // 'CMD1' guest -> host: one usercmd
+
+// player callsigns (index into kCoopNames), known on every machine; -1 = none yet
+static int s_playerName[COOP_MAX_CLIENTS] = { -1, -1, -1, -1 };
+static const char *Coop_NameOf(int n)
+{
+    int i = (n >= 0 && n < COOP_MAX_CLIENTS) ? s_playerName[n] : -1;
+    return (i >= 0 && i < COOP_NAME_COUNT) ? kCoopNames[i] : "A player";
+}
+// on-screen line for everybody (same text as the script command iprintln)
+static void Coop_Announce(const char *text)
+{
+    SV_GameSendServerCommand(-1, va("gm \"%s\"", text));
+}
+
+#define COOP_HELLO_MAGIC 0x314C4548 // 'HEL1' guest -> host: first thing sent, carries the password hash
+
+struct CoopHello
+{
+    unsigned int magic;
+    unsigned int passwordHash; // FNV-1a of coop_password (0 = none). A deterrent, not real security.
+    int nameIndex;             // the callsign this guest picked (index into kCoopNames)
+};
+
+static unsigned int Coop_PasswordHash(const char *pw)
+{
+    if (!*pw)
+        return 0;
+    unsigned int h = 2166136261u;
+    for (; *pw; pw++)
+        h = (h ^ (unsigned char)*pw) * 16777619u;
+    return h ? h : 1;
+}
+
+struct CoopCmdPacket
+{
+    unsigned int magic;
+    usercmd_s cmd;
+};
+
+void SV_CoopSetNetCmd(int n, const usercmd_s *cmd); // extra players section
+
+struct CoopChunkHeader
+{
+    unsigned int magic;
+    int frameDone;   // host level.framePos after its frame finished
+    int hostTime;    // host level time (ms)
+    unsigned int offset;
+    unsigned int len;
+};
+
+static bool s_wsaReady;
+
+static void Coop_InitWinsock()
+{
+    if (!s_wsaReady)
+    {
+        WSADATA wsa;
+        WSAStartup(0x0202, &wsa);
+        s_wsaReady = true;
+    }
+}
+
+static const char *Coop_Dvar(const char *name)
+{
+    const dvar_s *d = Dvar_FindVar(name);
+    return d ? Dvar_DisplayableValue(d) : "";
+}
+
+static bool Coop_SendAll(SOCKET s, const void *data, int len)
+{
+    const char *p = (const char *)data;
+    while (len > 0)
+    {
+        int n = send(s, p, len, 0);
+        if (n <= 0)
+            return false;
+        p += n;
+        len -= n;
+    }
+    return true;
+}
+
+// ============================================================================ host
+// Up to COOP_MAX_CLIENTS-1 guests. Each connection has its own player slot (index+1), send position and
+// input buffer; they all get the same recording, each from its own position in it.
+#define COOP_MAX_GUESTS (COOP_MAX_CLIENTS - 1)
+struct CoopGuestConn
+{
+    bool used;
+    SOCKET sock;
+    int slot;              // player slot this guest drives (1..)
+    bool wantsJoin;        // connected, not yet given a player (waits for player 0 to stand on ground)
+    bool announceJoin;     // show "X joined" for this player's next join (not after a checkpoint reload)
+    int nameIndex;
+    unsigned int sentEnd;  // bytes [0, sentEnd) of the recording have been sent to this guest
+    unsigned int dirtyFrom; // lowest byte that may still change (partial bit byte)
+    unsigned char rx[4096];
+    int rxLen;
+    unsigned char *out;    // data waiting to be sent (a slow or paused guest must never block the host)
+    int outLen, outCap;
+};
+#define COOP_MAX_OUTQ (24 * 1024 * 1024) // a guest further behind than this is dropped
+static bool s_hostRelayAnnounced;
+static SOCKET s_listen = INVALID_SOCKET;
+static CoopGuestConn s_guests[COOP_MAX_GUESTS];
+static bool s_pendingAnnounce[COOP_MAX_CLIENTS]; // the queued join should say "X joined"
+static bool s_pendingLeave[COOP_MAX_CLIENTS]; // a guest's connection dropped: record + apply the leave inside a frame
+static unsigned char *s_hostMsgData;   // detects a new recording (level change / load)
+
+static void Coop_DropGuest(CoopGuestConn &c, const char *why)
+{
+    if (c.used)
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: guest in slot %d dropped (%s)\n", c.slot, why);
+        closesocket(c.sock);
+        c.used = false;
+        c.sock = INVALID_SOCKET;
+        free(c.out);
+        c.out = 0;
+        c.outLen = c.outCap = 0;
+        s_pendingLeave[c.slot] = true;
+    }
+}
+
+static bool Coop_Queue(CoopGuestConn &c, const void *data, int len)
+{
+    if (c.outLen + len > COOP_MAX_OUTQ)
+    {
+        Coop_DropGuest(c, "too far behind (not reading)");
+        return false;
+    }
+    if (c.outLen + len > c.outCap)
+    {
+        int cap = c.outCap ? c.outCap : 65536;
+        while (cap < c.outLen + len)
+            cap *= 2;
+        c.out = (unsigned char *)realloc(c.out, cap);
+        c.outCap = cap;
+    }
+    memcpy(c.out + c.outLen, data, len);
+    c.outLen += len;
+    return true;
+}
+
+// send as much of the queue as the socket takes right now; never waits
+static bool Coop_Flush(CoopGuestConn &c)
+{
+    while (c.outLen > 0)
+    {
+        int n = send(c.sock, (const char *)c.out, c.outLen, 0);
+        if (n > 0)
+        {
+            memmove(c.out, c.out + n, c.outLen - n);
+            c.outLen -= n;
+            continue;
+        }
+        if (n < 0 && WSAGetLastError() == WSAEWOULDBLOCK)
+            return true;
+        Coop_DropGuest(c, "send failed");
+        return false;
+    }
+    return true;
+}
+
+// tell a guest which map the host is on, which player slot is theirs, and the savegame the host's
+// recording starts from (sent when the guest connects, and again whenever the host reloads a
+// checkpoint or changes level)
+static bool Coop_SendResetToGuest(CoopGuestConn &c)
+{
+    const unsigned char *save;
+    int saveLen;
+    if (!SV_CoopGetDemoSave(&save, &saveLen))
+    {
+        Coop_DropGuest(c, "new recording has no start savegame");
+        return false;
+    }
+    int total = COOP_RESET_PREFIX + saveLen;
+    unsigned char *payload = (unsigned char *)malloc(total);
+    memset(payload, 0, COOP_RESET_PREFIX);
+    I_strncpyz((char *)payload, Coop_Dvar("mapname"), COOP_MAP_NAME);
+    memcpy(payload + COOP_MAP_NAME, &c.slot, sizeof(int));
+    int kind = COOP_RESET_START;
+    memcpy(payload + COOP_MAP_NAME + 4, &kind, sizeof(int));
+    memcpy(payload + COOP_MAP_NAME + 8, &s_playerName[0], sizeof(int));
+    memcpy(payload + COOP_RESET_PREFIX, save, saveLen);
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: sending '%s' + %d byte start savegame to the guest in slot %d\n", (char *)payload, saveLen, c.slot);
+    for (int off = 0; off < total;)
+    {
+        int piece = total - off > COOP_MAX_PIECE ? COOP_MAX_PIECE : total - off;
+        CoopChunkHeader h;
+        h.magic = COOP_MAGIC;
+        h.frameDone = COOP_FRAME_RESET;
+        h.hostTime = total;
+        h.offset = off;
+        h.len = piece;
+        if (!Coop_Queue(c, &h, sizeof(h)) || !Coop_Queue(c, payload + off, piece))
+        {
+            free(payload);
+            return false;
+        }
+        off += piece;
+    }
+    free(payload);
+    return Coop_Flush(c);
+}
+
+extern int g_coopBodyEnt;
+
+// a guest joining mid-mission: instead of replaying the whole recording, send the game as it is now
+// plus where we are in the recording, and stream from there. Falls back to the full replay if the
+// snapshot cannot be taken.
+static bool Coop_SendSnapshotToGuest(CoopGuestConn &c)
+{
+    CoopSnapshot snap;
+    if (!SV_CoopTakeSnapshot(&snap))
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: snapshot failed, the guest will replay from the start\n");
+        return Coop_SendResetToGuest(c);
+    }
+    CoopSnapHeader hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.time = snap.time;
+    hdr.randomSeed = snap.randomSeed;
+    hdr.nextFramePos = snap.nextFramePos;
+    hdr.msgBit = snap.msgBit;
+    hdr.msgReadcount = snap.msgReadcount;
+    hdr.readType = snap.readType;
+    hdr.saveLen = snap.saveLen;
+    hdr.cmLen = snap.cmLen;
+    hdr.freeLen = snap.freeLen;
+    hdr.bodyEnt = g_coopBodyEnt;
+    hdr.lastUsercmd = snap.lastUsercmd;
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        hdr.slots[n].active = svs.clients[n].state == 1;
+        hdr.slots[n].name = s_playerName[n];
+        hdr.slots[n].lastUsercmd = svs.clients[n].lastUsercmd;
+    }
+    int total = COOP_RESET_PREFIX + (int)sizeof(hdr) + snap.saveLen + snap.cmLen + snap.freeLen;
+    unsigned char *payload = (unsigned char *)malloc(total);
+    memset(payload, 0, COOP_RESET_PREFIX);
+    I_strncpyz((char *)payload, Coop_Dvar("mapname"), COOP_MAP_NAME);
+    memcpy(payload + COOP_MAP_NAME, &c.slot, sizeof(int));
+    int kind = COOP_RESET_SNAPSHOT;
+    memcpy(payload + COOP_MAP_NAME + 4, &kind, sizeof(int));
+    memcpy(payload + COOP_MAP_NAME + 8, &s_playerName[0], sizeof(int));
+    unsigned char *w = payload + COOP_RESET_PREFIX;
+    memcpy(w, &hdr, sizeof(hdr)); w += sizeof(hdr);
+    memcpy(w, snap.save, snap.saveLen); w += snap.saveLen;
+    memcpy(w, snap.cm, snap.cmLen); w += snap.cmLen;
+    memcpy(w, snap.freeEnt, snap.freeLen);
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: sending a snapshot of '%s' (%d bytes, frame %d) to the guest in slot %d\n", (char *)payload, total, snap.nextFramePos, c.slot);
+    for (int off = 0; off < total;)
+    {
+        int piece = total - off > COOP_MAX_PIECE ? COOP_MAX_PIECE : total - off;
+        CoopChunkHeader h;
+        h.magic = COOP_MAGIC;
+        h.frameDone = COOP_FRAME_RESET;
+        h.hostTime = total;
+        h.offset = off;
+        h.len = piece;
+        if (!Coop_Queue(c, &h, sizeof(h)) || !Coop_Queue(c, payload + off, piece))
+        {
+            free(payload);
+            SV_CoopFreeSnapshot(&snap);
+            return false;
+        }
+        off += piece;
+    }
+    free(payload);
+    // the live stream continues from the snapshot's position (a partly written byte is sent again)
+    c.sentEnd = snap.msgReadcount;
+    c.dirtyFrom = (snap.msgBit & 7) ? (unsigned int)(snap.msgBit >> 3) : (unsigned int)snap.msgReadcount;
+    SV_CoopFreeSnapshot(&snap);
+    return Coop_Flush(c);
+}
+
+// a new connection: password check, then slot + backlog
+// a free guest slot, or 0 when the game is full / at its chosen size
+static CoopGuestConn *Coop_FreeConn()
+{
+    CoopGuestConn *free_c = 0;
+    for (int i = 0; i < COOP_MAX_GUESTS; i++)
+        if (!s_guests[i].used)
+        {
+            free_c = &s_guests[i];
+            free_c->slot = i + 1;
+            break;
+        }
+    if (!free_c)
+        return 0; // full: further guests wait in the listen queue
+    // +set coop_maxplayers N (2..4): total players including the host
+    int maxPlayers = atoi(Coop_Dvar("coop_maxplayers"));
+    if (maxPlayers < 2 || maxPlayers > COOP_MAX_CLIENTS)
+        maxPlayers = COOP_MAX_CLIENTS;
+    int connected = 0;
+    for (int i = 0; i < COOP_MAX_GUESTS; i++)
+        connected += s_guests[i].used;
+    if (connected >= maxPlayers - 1)
+        return 0; // the game is at its chosen size
+    return free_c;
+}
+
+// a new guest connection (from the listen socket or from the relay): password check, then slot + backlog
+static void Coop_AdmitGuest(SOCKET g, CoopGuestConn *free_c)
+{
+    u_long nb = 0;
+    ioctlsocket(g, FIONBIO, &nb); // blocking sends: small chunks on a LAN
+    int one = 1;
+    setsockopt(g, IPPROTO_TCP, TCP_NODELAY, (const char *)&one, sizeof(one));
+    DWORD sendTimeout = 20000; // a stalled guest must not freeze the host (a level load takes a while)
+    setsockopt(g, SOL_SOCKET, SO_SNDTIMEO, (const char *)&sendTimeout, sizeof(sendTimeout));
+    // the guest's first message is its hello (password hash); wait a moment for it
+    DWORD rcvTimeout = 3000;
+    setsockopt(g, SOL_SOCKET, SO_RCVTIMEO, (const char *)&rcvTimeout, sizeof(rcvTimeout));
+    CoopHello hello;
+    int got = 0;
+    while (got < (int)sizeof(hello))
+    {
+        int n = recv(g, (char *)&hello + got, sizeof(hello) - got, 0);
+        if (n <= 0)
+            break;
+        got += n;
+    }
+    DWORD none = 0;
+    setsockopt(g, SOL_SOCKET, SO_RCVTIMEO, (const char *)&none, sizeof(none));
+    u_long nonblocking = 1;
+    ioctlsocket(g, FIONBIO, &nonblocking); // from here on a slow guest can never stall the host
+    unsigned int want = Coop_PasswordHash(Coop_Dvar("coop_password"));
+    if (got < (int)sizeof(hello) || hello.magic != COOP_HELLO_MAGIC || (want && hello.passwordHash != want))
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: guest refused (%s)\n", got < (int)sizeof(hello) ? "no hello" : "wrong password");
+        closesocket(g);
+        return;
+    }
+    // the callsign: what the guest asked for, or the next free one if it is taken
+    {
+        int want = hello.nameIndex;
+        if (want < 0 || want >= COOP_NAME_COUNT)
+            want = 0;
+        for (int tries = 0; tries < COOP_NAME_COUNT; tries++, want = (want + 1) % COOP_NAME_COUNT)
+        {
+            bool taken = false;
+            for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+                if (s_playerName[n] == want && (n == 0 || svs.clients[n].state == 1 || s_guests[n - 1].used))
+                    taken = true;
+            if (!taken)
+                break;
+        }
+        free_c->nameIndex = want;
+        s_playerName[free_c->slot] = want;
+    }
+    free_c->announceJoin = true;
+    free_c->used = true;
+    free_c->sock = g;
+    free_c->wantsJoin = true;
+    free_c->sentEnd = free_c->dirtyFrom = 0;
+    free_c->rxLen = 0;
+    free_c->outLen = 0;
+    // a long recording means the host is well into the mission: join from a snapshot, not from the start
+    bool lateJoin = sv.demo.msg.cursize > 150000 && atoi(Coop_Dvar("coop_nosnapshot")) == 0;
+    if (!(lateJoin ? Coop_SendSnapshotToGuest(*free_c) : Coop_SendResetToGuest(*free_c)))
+        return;
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: guest connected as player %d, streaming %d bytes of backlog\n", free_c->slot, sv.demo.msg.cursize);
+}
+
+static void Coop_AcceptGuest()
+{
+    CoopGuestConn *c = Coop_FreeConn();
+    if (!c)
+        return;
+    SOCKET g = accept(s_listen, 0, 0);
+    if (g == INVALID_SOCKET)
+        return;
+    Coop_AdmitGuest(g, c);
+}
+
+// ---- relay (see kisak/relay/relay.py): both sides connect OUT to it and meet by room code
+// Connect to "host[:port]" (a name or an IP) within timeoutMs; the returned socket is blocking.
+static bool Coop_ConnectTcp(const char *spec, int defaultPort, int timeoutMs, SOCKET *out)
+{
+    char host[128];
+    int port = defaultPort;
+    I_strncpyz(host, spec, sizeof(host));
+    char *colon = strrchr(host, ':');
+    if (colon)
+    {
+        *colon = 0;
+        port = atoi(colon + 1);
+    }
+    Coop_InitWinsock();
+    sockaddr_in a = {};
+    a.sin_family = AF_INET;
+    a.sin_port = htons((u_short)port);
+    unsigned long ip = inet_addr(host);
+    if (ip == INADDR_NONE)
+    {
+        hostent *he = gethostbyname(host);
+        if (!he || he->h_addrtype != AF_INET || !he->h_addr_list[0])
+            return false;
+        memcpy(&a.sin_addr, he->h_addr_list[0], 4);
+    }
+    else
+        a.sin_addr.s_addr = ip;
+    SOCKET sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    u_long nb = 1;
+    ioctlsocket(sock, FIONBIO, &nb);
+    if (connect(sock, (sockaddr *)&a, sizeof(a)) != 0 && WSAGetLastError() != WSAEWOULDBLOCK)
+    {
+        closesocket(sock);
+        return false;
+    }
+    fd_set wf;
+    FD_ZERO(&wf);
+    FD_SET(sock, &wf);
+    timeval tv = { timeoutMs / 1000, (timeoutMs % 1000) * 1000 };
+    int err = 0, len = sizeof(err);
+    if (select(0, 0, &wf, 0, &tv) <= 0 || getsockopt(sock, SOL_SOCKET, SO_ERROR, (char *)&err, &len) != 0 || err)
+    {
+        closesocket(sock);
+        return false;
+    }
+    nb = 0;
+    ioctlsocket(sock, FIONBIO, &nb);
+    int one = 1;
+    setsockopt(sock, IPPROTO_TCP, TCP_NODELAY, (const char *)&one, sizeof(one));
+    *out = sock;
+    return true;
+}
+
+static SOCKET s_relayCtl = INVALID_SOCKET; // the host's control line to the relay
+static char s_room[16];                    // room code the relay gave us
+static char s_relayBuf[256];
+static int s_relayBufLen;
+static DWORD s_relayRetry, s_relayPing, s_nextRoomAnnounce;
+bool SV_CoopHostHasGuest(); // defined further down
+
+static void Coop_RelayClose(const char *why)
+{
+    if (s_relayCtl != INVALID_SOCKET)
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: relay connection closed (%s)\n", why);
+        closesocket(s_relayCtl);
+        s_relayCtl = INVALID_SOCKET;
+    }
+    s_room[0] = 0;
+    s_relayBufLen = 0;
+}
+
+// host: keep a control line open to the relay and answer every "GUEST id" with a data connection
+static void Coop_RelayPump()
+{
+    // copy: Coop_Dvar hands out text from a small rotating scratch buffer that later calls overwrite
+    char relay[128];
+    I_strncpyz(relay, Coop_Dvar("coop_relay"), sizeof(relay));
+    DWORD now = GetTickCount();
+    if (s_relayCtl == INVALID_SOCKET)
+    {
+        if ((int)(now - s_relayRetry) < 0)
+            return;
+        s_relayRetry = now + 15000;
+        SOCKET c;
+        if (!Coop_ConnectTcp(relay, 28999, 2500, &c))
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: cannot reach the relay at %s (will retry)\n", relay);
+            return;
+        }
+        // +set coop_roomname NAME asks for that room name (the relay refuses a taken one); else a random code
+        char hostLine[64];
+        char roomName[24];
+        I_strncpyz(roomName, Coop_Dvar("coop_roomname"), sizeof(roomName));
+        int hl = roomName[0] ? _snprintf(hostLine, sizeof(hostLine), "HOST %s\n", roomName) : _snprintf(hostLine, sizeof(hostLine), "HOST\n");
+        send(c, hostLine, hl, 0);
+        DWORD rcvTimeout = 3000;
+        setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, (const char *)&rcvTimeout, sizeof(rcvTimeout));
+        char line[64] = {};
+        int got = 0;
+        while (got < (int)sizeof(line) - 1)
+        {
+            int n = recv(c, line + got, 1, 0);
+            if (n <= 0 || line[got] == '\n')
+                break;
+            got += n;
+        }
+        DWORD none = 0;
+        setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, (const char *)&none, sizeof(none));
+        if (strncmp(line, "ROOM ", 5) != 0 || strlen(line) < 6)
+        {
+            for (char *e = line; *e; ++e)
+                if (*e == '\r' || *e == '\n')
+                    *e = 0;
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: the relay refused us (%s)\n", line);
+            if (!strncmp(line, "ERR ", 4))
+                Coop_Announce(va("Relay: %s", line + 4)); // e.g. the room name is taken
+            closesocket(c);
+            return;
+        }
+        I_strncpyz(s_room, line + 5, sizeof(s_room));
+        for (char *r = s_room; *r; ++r)
+            if (*r == '\r' || *r == '\n')
+                *r = 0;
+        u_long nb = 1;
+        ioctlsocket(c, FIONBIO, &nb);
+        s_relayCtl = c;
+        s_relayPing = now + 20000;
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: room code %s on relay %s\n", s_room, relay);
+        Dvar_SetFromString((dvar_s *)Dvar_FindVar("coop_room"), s_room);
+        if (FILE *f = fopen("coop_room.txt", "w"))
+        {
+            fprintf(f, "%s\n", s_room);
+            fclose(f);
+        }
+        Coop_Announce(va("Room code: %s", s_room));
+        s_nextRoomAnnounce = now + 30000;
+    }
+
+    // keep telling the host the room code until somebody has joined (a single message is easy to miss)
+    if (s_room[0] && !SV_CoopHostHasGuest() && (int)(now - s_nextRoomAnnounce) >= 0)
+    {
+        Coop_Announce(va("Room code: %s  (relay %s)", s_room, relay));
+        s_nextRoomAnnounce = now + 30000;
+    }
+
+    // control line: "GUEST <id>\n" for every guest that wants in
+    for (;;)
+    {
+        int n = recv(s_relayCtl, s_relayBuf + s_relayBufLen, (int)sizeof(s_relayBuf) - 1 - s_relayBufLen, 0);
+        if (n == 0)
+        {
+            Coop_RelayClose("the relay hung up");
+            return;
+        }
+        if (n < 0)
+        {
+            if (WSAGetLastError() != WSAEWOULDBLOCK)
+            {
+                Coop_RelayClose("read error");
+                return;
+            }
+            break;
+        }
+        s_relayBufLen += n;
+        s_relayBuf[s_relayBufLen] = 0;
+        char *nl;
+        while ((nl = strchr(s_relayBuf, '\n')) != 0)
+        {
+            *nl = 0;
+            char id[32] = {};
+            if (sscanf(s_relayBuf, "GUEST %31s", id) == 1)
+            {
+                CoopGuestConn *fc = Coop_FreeConn();
+                SOCKET d;
+                if (fc && Coop_ConnectTcp(relay, 28999, 3000, &d))
+                {
+                    char hello[96];
+                    int hl = _snprintf(hello, sizeof(hello), "DATA %s %s\n", s_room, id);
+                    send(d, hello, hl, 0);
+                    Coop_AdmitGuest(d, fc); // from here on an ordinary guest connection
+                }
+            }
+            int consumed = (int)(nl + 1 - s_relayBuf);
+            memmove(s_relayBuf, nl + 1, s_relayBufLen - consumed);
+            s_relayBufLen -= consumed;
+            s_relayBuf[s_relayBufLen] = 0;
+        }
+    }
+    if ((int)(now - s_relayPing) >= 0)
+    {
+        send(s_relayCtl, "P\n", 2, 0); // keeps the line from going idle
+        s_relayPing = now + 20000;
+    }
+}
+
+void SV_CoopHostFrame()
+{
+    int port = atoi(Coop_Dvar("coop_host"));
+    if (port <= 0)
+        return;
+    if (port == 1)
+        port = COOP_DEFAULT_PORT;
+
+    Coop_InitWinsock();
+    // +set coop_relay <host[:port]>: guests come in through the relay, nothing listens on this machine
+    bool relayMode = *Coop_Dvar("coop_relay") != 0;
+    if (relayMode && s_hostRelayAnnounced == false)
+    {
+        s_hostRelayAnnounced = true;
+        int hn = atoi(Coop_Dvar("coop_name"));
+        s_playerName[0] = (hn >= 0 && hn < COOP_NAME_COUNT) ? hn : 0;
+    }
+    if (!relayMode && s_listen == INVALID_SOCKET)
+    {
+        s_listen = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+        sockaddr_in a = {};
+        a.sin_family = AF_INET;
+        // +set coop_bind local : listen on this machine only (for a relay/launcher that forwards guests in)
+        a.sin_addr.s_addr = !I_stricmp(Coop_Dvar("coop_bind"), "local") ? inet_addr("127.0.0.1") : INADDR_ANY;
+        a.sin_port = htons((u_short)port);
+        int yes = 1;
+        setsockopt(s_listen, SOL_SOCKET, SO_REUSEADDR, (const char *)&yes, sizeof(yes));
+        if (bind(s_listen, (sockaddr *)&a, sizeof(a)) || listen(s_listen, COOP_MAX_GUESTS))
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: cannot listen on tcp %d (%d)\n", port, WSAGetLastError());
+            closesocket(s_listen);
+            s_listen = INVALID_SOCKET;
+            Dvar_SetFromString((dvar_s *)Dvar_FindVar("coop_host"), "0");
+            return;
+        }
+        {
+            int hn = atoi(Coop_Dvar("coop_name")); // +set coop_name N (launcher)
+            s_playerName[0] = (hn >= 0 && hn < COOP_NAME_COUNT) ? hn : 0;
+        }
+        u_long nb = 1;
+        ioctlsocket(s_listen, FIONBIO, &nb);
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: listening on tcp %d%s (up to %d guests)\n", port,
+            !I_stricmp(Coop_Dvar("coop_bind"), "local") ? " (this machine only)" : "", COOP_MAX_GUESTS);
+    }
+
+    if (!sv.demo.recording || !sv.demo.msg.data)
+        return; // nothing to stream (e.g. during a replay)
+
+    // a checkpoint reload (or level load) started a new recording: every connected guest gets the new
+    // start savegame and is streamed from the beginning again. The reload cleared the extra player
+    // slots, so each guest is re-added like a fresh join.
+    if (g_coopRecordingGen != s_hostRecGen || sv.demo.msg.data != s_hostMsgData)
+    {
+        for (int i = 0; i < COOP_MAX_GUESTS; i++)
+        {
+            CoopGuestConn &c = s_guests[i];
+            if (!c.used)
+                continue;
+            if (!Coop_SendResetToGuest(c))
+                continue;
+            c.sentEnd = c.dirtyFrom = 0;
+            c.wantsJoin = true;
+            c.announceJoin = false; // they are not new, the level was just reloaded
+        }
+        s_hostRecGen = g_coopRecordingGen;
+        s_hostMsgData = sv.demo.msg.data;
+    }
+
+    if (relayMode)
+        Coop_RelayPump();
+    else
+        Coop_AcceptGuest();
+
+    for (int i = 0; i < COOP_MAX_GUESTS; i++)
+    {
+        CoopGuestConn &c = s_guests[i];
+        if (!c.used)
+            continue;
+
+        // guest input
+        u_long avail = 0;
+        while (c.used && ioctlsocket(c.sock, FIONREAD, &avail) == 0 && avail > 0)
+        {
+            int n = recv(c.sock, (char *)c.rx + c.rxLen, sizeof(c.rx) - c.rxLen, 0);
+            if (n <= 0)
+            {
+                Coop_DropGuest(c, "guest disconnected");
+                break;
+            }
+            c.rxLen += n;
+            int pos = 0;
+            while (c.rxLen - pos >= (int)sizeof(CoopCmdPacket))
+            {
+                CoopCmdPacket pkt;
+                memcpy(&pkt, c.rx + pos, sizeof(pkt));
+                pos += sizeof(pkt);
+                if (pkt.magic != COOP_CMD_MAGIC)
+                {
+                    Coop_DropGuest(c, "bad input stream");
+                    break;
+                }
+                SV_CoopSetNetCmd(c.slot, &pkt.cmd);
+            }
+            if (!c.used)
+                break;
+            memmove(c.rx, c.rx + pos, c.rxLen - pos);
+            c.rxLen -= pos;
+        }
+        if (!c.used)
+            continue;
+
+        if ((unsigned int)sv.demo.msg.cursize < c.sentEnd)
+            c.sentEnd = c.dirtyFrom = 0; // recording shrank without a new generation: stream it again
+        unsigned int from = c.sentEnd < c.dirtyFrom ? c.sentEnd : c.dirtyFrom;
+        unsigned int to = sv.demo.msg.cursize;
+
+        // split into pieces that fit the guest's receive buffer; only the last piece
+        // announces the finished frame, so the guest never runs ahead of the bytes
+        unsigned int off = from;
+        do
+        {
+            unsigned int piece = to - off;
+            if (piece > COOP_MAX_PIECE)
+                piece = COOP_MAX_PIECE;
+            CoopChunkHeader h;
+            h.magic = COOP_MAGIC;
+            h.frameDone = (off + piece == to) ? G_GetFramePos() : COOP_FRAME_PENDING;
+            h.hostTime = G_GetTime();
+            h.offset = off;
+            h.len = piece;
+            if (!Coop_Queue(c, &h, sizeof(h)) || (h.len && !Coop_Queue(c, sv.demo.msg.data + off, h.len)))
+                break;
+            off += piece;
+        } while (off < to);
+        if (!c.used || !Coop_Flush(c))
+            continue;
+        c.sentEnd = to;
+        // the bit writer ORs later bits into its current partial byte, so resend from it next time
+        c.dirtyFrom = (sv.demo.msg.bit & 7) ? (unsigned int)(sv.demo.msg.bit >> 3) : to;
+    }
+}
+
+// ============================================================================ guest
+enum CoopGuestState { GUEST_OFF, GUEST_WAIT_LEVEL, GUEST_FOLLOWING, GUEST_WAIT_MAP, GUEST_FAILED };
+static CoopGuestState s_gstate = GUEST_OFF;
+static SOCKET s_hostSock = INVALID_SOCKET;
+static char s_connectError[96]; // what the relay said when it refused us
+static unsigned char s_rx[64 * 1024];
+static int s_rxLen;
+static int s_hostFrameDone = -1;
+static int s_hostTime;
+static int s_hostBytes;
+
+// the host's new start savegame, being received piece by piece (checkpoint reload)
+static unsigned char *s_resetSave;
+static int s_resetSaveLen;
+static bool s_resetReady; // complete: the caller must restart the replay from it
+
+// read whatever arrived; apply complete chunks into sv.demo.msg.
+// Stops right after a complete reset savegame (s_resetReady): whatever follows belongs to the
+// new recording and must not be written over the replay that is still running.
+static bool Coop_GuestPoll()
+{
+    for (;;)
+    {
+        if (s_resetReady)
+            return true;
+        int pos = 0;
+        while (s_rxLen - pos >= (int)sizeof(CoopChunkHeader))
+        {
+            CoopChunkHeader h;
+            memcpy(&h, s_rx + pos, sizeof(h));
+            if (h.magic != COOP_MAGIC)
+            {
+                if (!strncmp((const char *)s_rx + pos, "ERR ", 4)) // the relay refused us
+                {
+                    I_strncpyz(s_connectError, (const char *)s_rx + pos + 4, sizeof(s_connectError));
+                    for (char *e = s_connectError; *e; ++e)
+                        if (*e == '\r' || *e == '\n')
+                            *e = 0;
+                }
+                Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: bad stream\n");
+                return false;
+            }
+            if (s_rxLen - pos < (int)(sizeof(h) + h.len))
+                break;
+            if (h.frameDone == COOP_FRAME_RESET)
+            {
+                if (h.offset == 0)
+                {
+                    free(s_resetSave);
+                    s_resetSave = (unsigned char *)malloc(h.hostTime);
+                    s_resetSaveLen = h.hostTime;
+                }
+                if (!s_resetSave || h.offset + h.len > (unsigned int)s_resetSaveLen)
+                {
+                    Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: bad start savegame piece\n");
+                    return false;
+                }
+                memcpy(s_resetSave + h.offset, s_rx + pos + sizeof(h), h.len);
+                pos += sizeof(h) + h.len;
+                if ((int)(h.offset + h.len) == s_resetSaveLen)
+                {
+                    s_resetReady = true;
+                    break;
+                }
+                continue;
+            }
+            if (h.offset + h.len > (unsigned int)sv.demo.msg.maxsize)
+            {
+                Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: stream exceeds replay buffer\n");
+                return false;
+            }
+            memcpy(sv.demo.msg.data + h.offset, s_rx + pos + sizeof(h), h.len);
+            if ((int)(h.offset + h.len) > sv.demo.msg.cursize)
+                sv.demo.msg.cursize = h.offset + h.len;
+            if (h.frameDone != COOP_FRAME_PENDING)
+            {
+                s_hostFrameDone = h.frameDone;
+                s_hostTime = h.hostTime;
+            }
+            s_hostBytes = h.offset + h.len;
+            pos += sizeof(h) + h.len;
+        }
+        memmove(s_rx, s_rx + pos, s_rxLen - pos);
+        s_rxLen -= pos;
+        if (s_resetReady)
+            return true;
+        if (s_rxLen == sizeof(s_rx))
+            return false; // chunk larger than buffer
+
+        int n = recv(s_hostSock, (char *)s_rx + s_rxLen, sizeof(s_rx) - s_rxLen, 0);
+        if (n == 0)
+            return false;
+        if (n < 0)
+            break; // WSAEWOULDBLOCK or error; checked below
+        s_rxLen += n;
+    }
+    return WSAGetLastError() == WSAEWOULDBLOCK;
+}
+
+static bool Coop_GuestConnect(const char *target)
+{
+    const char *at = strchr(target, '@');
+    if (at)
+    {
+        // "ROOMCODE@relay-address[:port]": meet the host through the relay (see kisak/relay/relay.py)
+        char code[32] = {};
+        int cl = (int)(at - target);
+        if (cl <= 0 || cl >= (int)sizeof(code))
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: bad room code in '%s'\n", target);
+            return false;
+        }
+        memcpy(code, target, cl);
+        for (char *c = code; *c; ++c)
+            *c = (char)toupper((unsigned char)*c);
+        if (!Coop_ConnectTcp(at + 1, 28999, 5000, &s_hostSock))
+        {
+            s_hostSock = INVALID_SOCKET;
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: cannot reach the relay at %s\n", at + 1);
+            return false;
+        }
+        char join[64];
+        int jl = _snprintf(join, sizeof(join), "JOIN %s\n", code);
+        send(s_hostSock, join, jl, 0);
+    }
+    else
+    {
+    char ip[64];
+    int port = COOP_DEFAULT_PORT;
+    I_strncpyz(ip, target, sizeof(ip));
+    char *colon = strchr(ip, ':');
+    if (colon)
+    {
+        *colon = 0;
+        port = atoi(colon + 1);
+    }
+    Coop_InitWinsock();
+    s_hostSock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    sockaddr_in a = {};
+    a.sin_family = AF_INET;
+    a.sin_addr.s_addr = inet_addr(ip);
+    a.sin_port = htons((u_short)port);
+    if (connect(s_hostSock, (sockaddr *)&a, sizeof(a)))
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: cannot connect to %s:%d (%d)\n", ip, port, WSAGetLastError());
+        closesocket(s_hostSock);
+        s_hostSock = INVALID_SOCKET;
+        return false;
+    }
+    }
+    u_long nb = 1;
+    ioctlsocket(s_hostSock, FIONBIO, &nb);
+    int myName = atoi(Coop_Dvar("coop_name"));
+    CoopHello hello = { COOP_HELLO_MAGIC, Coop_PasswordHash(Coop_Dvar("coop_password")), (myName >= 0 && myName < COOP_NAME_COUNT) ? myName : 0 };
+    send(s_hostSock, (const char *)&hello, sizeof(hello), 0);
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: connected to %s\n", target);
+    return true;
+}
+
+// the host reloaded a checkpoint: restart our replay from its start savegame, then follow the
+// new recording. The old replay is dropped (its last ~100 ms are gone with the old timeline).
+static unsigned int s_waitMapGen; // recording count when the map change was requested
+static int s_resetKind;           // kind of the reset being applied (start savegame / snapshot)
+static struct { int active[COOP_MAX_CLIENTS]; int name[COOP_MAX_CLIENTS]; usercmd_s cmd[COOP_MAX_CLIENTS]; int bodyEnt; } s_snapFix;
+static bool s_snapFixPending;      // after a snapshot restart: restore the per-player details once the level is up
+static int s_mySlot = 1;          // the player slot the host gave this guest
+
+// second half: the right map is loaded; restart the replay from the host's start savegame
+static bool Coop_GuestFinishReset()
+{
+    while (s_resetReady)
+    {
+        s_resetReady = false;
+        memcpy(&s_resetKind, s_resetSave + COOP_MAP_NAME + 4, sizeof(int));
+        if (s_resetKind == COOP_RESET_SNAPSHOT)
+        {
+            CoopSnapHeader hdr;
+            memcpy(&hdr, s_resetSave + COOP_RESET_PREFIX, sizeof(hdr));
+            const unsigned char *r = s_resetSave + COOP_RESET_PREFIX + sizeof(hdr);
+            CoopSnapshot snap;
+            memset(&snap, 0, sizeof(snap));
+            snap.time = hdr.time; snap.randomSeed = hdr.randomSeed; snap.nextFramePos = hdr.nextFramePos;
+            snap.msgBit = hdr.msgBit; snap.msgReadcount = hdr.msgReadcount; snap.readType = hdr.readType;
+            snap.lastUsercmd = hdr.lastUsercmd;
+            snap.saveLen = hdr.saveLen; snap.cmLen = hdr.cmLen; snap.freeLen = hdr.freeLen;
+            snap.save = (unsigned char *)r;
+            snap.cm = (unsigned char *)r + hdr.saveLen;
+            snap.freeEnt = (unsigned char *)r + hdr.saveLen + hdr.cmLen;
+            SV_CoopInstallSnapshot(&snap); // copies
+            for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+            {
+                s_snapFix.active[n] = hdr.slots[n].active;
+                s_snapFix.name[n] = hdr.slots[n].name;
+                s_snapFix.cmd[n] = hdr.slots[n].lastUsercmd;
+            }
+            s_snapFix.bodyEnt = hdr.bodyEnt;
+            s_snapFixPending = true;
+        }
+        else if (!SV_CoopSetDemoSave(s_resetSave + COOP_RESET_PREFIX, s_resetSaveLen - COOP_RESET_PREFIX))
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: cannot store the host's start savegame\n");
+            return false;
+        }
+        sv.demo.msg.cursize = 0;
+        s_hostFrameDone = -1;
+        int start = Sys_Milliseconds();
+        while (s_hostFrameDone < 2 && !s_resetReady && Sys_Milliseconds() - start < 10000)
+        {
+            if (!Coop_GuestPoll())
+                return false;
+            Sleep(1);
+        }
+        if (s_resetReady)
+            continue; // the host reloaded again meanwhile
+        if (s_hostFrameDone < 2)
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: no stream after the host's reload\n");
+            return false;
+        }
+    }
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: host sent a %s (%d bytes); restarting replay from it, host time %d ms\n",
+        s_resetKind == COOP_RESET_SNAPSHOT ? "snapshot" : "start savegame", s_resetSaveLen - COOP_RESET_PREFIX, s_hostTime);
+    if (s_resetKind != COOP_RESET_SNAPSHOT)
+    {
+        sv.demo.nextLevelSave = 0;
+        sv.demo.nextLevelTime = s_hostTime;
+    }
+    SV_DemoRestart();
+    s_gstate = GUEST_FOLLOWING;
+    return true;
+}
+
+// the host reloaded a checkpoint or changed level: if it is another map, load that first
+static bool Coop_GuestApplyReset()
+{
+    const char *hostMap = (const char *)s_resetSave;
+    memcpy(&s_mySlot, s_resetSave + COOP_MAP_NAME, sizeof(int)); // which player this guest is
+    memcpy(&s_playerName[0], s_resetSave + COOP_MAP_NAME + 8, sizeof(int)); // and what the host is called
+    if (s_mySlot < 1 || s_mySlot >= COOP_MAX_CLIENTS)
+        s_mySlot = 1;
+    if (I_stricmp(hostMap, Coop_Dvar("mapname")))
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: host moved to map '%s' (we are on '%s'); loading it\n", hostMap, Coop_Dvar("mapname"));
+        s_waitMapGen = g_coopRecordingGen;
+        s_gstate = GUEST_WAIT_MAP;
+        Cbuf_AddText(0, va("spmap %s\n", hostMap));
+        return true; // the reset stays pending until the new level is up
+    }
+    return Coop_GuestFinishReset();
+}
+
+static void Coop_ApplySnapshotFix(); // defined with the player bodies, further down
+
+static void Coop_GuestFail(const char *why)
+{
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: %s\n", why);
+    closesocket(s_hostSock);
+    s_hostSock = INVALID_SOCKET;
+    s_gstate = GUEST_FAILED;
+}
+
+// called before every G_RunFrame on the server thread
+void SV_CoopGuestFrame()
+{
+    char target[160]; // copy (see Coop_RelayPump): the scratch buffer behind Coop_Dvar gets reused
+    I_strncpyz(target, Coop_Dvar("coop_connect"), sizeof(target));
+    if (!*target || s_gstate == GUEST_FAILED)
+        return;
+
+    if (s_gstate == GUEST_OFF)
+        s_gstate = GUEST_WAIT_LEVEL;
+
+    if (s_gstate == GUEST_WAIT_LEVEL)
+    {
+        // wait for our own copy of the level to be up, then take over its replay buffer
+        if (!sv.demo.recording || !sv.demo.msg.data || G_GetTime() < 1000)
+            return;
+        if (!Coop_GuestConnect(target))
+        {
+            s_gstate = GUEST_FAILED;
+            // visible to the player instead of silently playing alone
+            Com_Error(ERR_DROP, "Could not connect to the host at %s. Check the address and that the host has started the game.", target);
+            return;
+        }
+        // the host's first message says which map it is on and which savegame its recording started
+        // from; the same path as after a host checkpoint reload / level change then takes over
+        s_resetReady = false;
+        int start = Sys_Milliseconds();
+        while (!s_resetReady && Sys_Milliseconds() - start < 10000)
+        {
+            if (!Coop_GuestPoll())
+                break;
+            Sleep(1);
+        }
+        if (!s_resetReady)
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: no stream from host\n");
+            s_gstate = GUEST_FAILED;
+            if (s_connectError[0])
+                Com_Error(ERR_DROP, "The relay said: %s", s_connectError);
+            Com_Error(ERR_DROP, "The host did not let you in. Check the password, and that the host has started the mission.");
+            return;
+        }
+        s_gstate = GUEST_FOLLOWING; // FinishReset / the map change below manage the state from here
+        if (!Coop_GuestApplyReset())
+            Coop_GuestFail("could not follow the host");
+        return;
+    }
+
+    if (s_gstate == GUEST_WAIT_MAP)
+    {
+        // our new level has started recording: take over its replay buffer and follow the host
+        if (g_coopRecordingGen == s_waitMapGen || !sv.demo.recording || !sv.demo.msg.data)
+            return;
+        s_resetReady = true; // the savegame we stored is still in s_resetSave
+        if (!Coop_GuestFinishReset())
+            Coop_GuestFail("could not follow the host to its new map");
+        return;
+    }
+
+    // GUEST_FOLLOWING
+    // Keep reading the host even when no replay is running: the old recording ends with an end
+    // marker (the replay stops right there) and the host's reload only arrives after it.
+    if (!Coop_GuestPoll())
+    {
+        Coop_GuestFail("host connection lost");
+        return;
+    }
+    if (s_resetReady)
+    {
+        if (!Coop_GuestApplyReset())
+            Coop_GuestFail("could not follow the host's reload");
+        return;
+    }
+    if (!sv.demo.playing)
+        return; // restart pending, or the replay ended (waiting for the host's reload)
+    if (s_snapFixPending)
+        Coop_ApplySnapshotFix();
+    // send every input command the local client built since last frame (each carries its own
+    // serverTime); the host runs them all in order, so our prediction matches its result
+    {
+        static int lastSent = -1;
+        CoopCmdPacket pkts[64];
+        int count = 0;
+        Sys_EnterCriticalSection(CRITSECT_CLIENT_CMD);
+        int newest = clients[0].cmdNumber;
+        if (lastSent < 0 || newest - lastSent > 63)
+            lastSent = newest - 1;
+        for (int c = lastSent + 1; c <= newest; c++)
+        {
+            pkts[count].magic = COOP_CMD_MAGIC;
+            pkts[count].cmd = clients[0].cmds[c & 63];
+            count++;
+        }
+        Sys_LeaveCriticalSection(CRITSECT_CLIENT_CMD);
+        lastSent = newest;
+        if (count)
+            send(s_hostSock, (const char *)pkts, count * sizeof(CoopCmdPacket), 0);
+    }
+
+    // catch up: a guest that fell behind (join, load hitch) fast-forwards with rendering off
+    int lag = s_hostTime - G_GetTime();
+    if (lag > COOP_MAX_LAG_MS && !sv.demo.forwardMsec)
+    {
+        int skip = (lag - COOP_TARGET_LAG_MS) / 50 * 50;
+        Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: %d ms behind host, fast-forwarding %d ms\n", lag, skip);
+        CL_SetSkipRendering(1);
+        sv.demo.forwardMsec = skip;
+    }
+
+    // frame N = framePos+1 reads ahead into frame N+1, so the host must have finished N+1
+    int need = G_GetFramePos() + 2;
+    int start = Sys_Milliseconds();
+    while (s_hostFrameDone < need)
+    {
+        if (!Coop_GuestPoll())
+            return; // handled next frame
+        if (s_resetReady)
+        {
+            if (!Coop_GuestApplyReset())
+                Coop_GuestFail("could not follow the host's reload");
+            return;
+        }
+        if (Sys_Milliseconds() - start > 5000)
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: waiting on host (have frame %d, need %d)\n", s_hostFrameDone, need);
+            start = Sys_Milliseconds();
+        }
+        Sleep(1);
+    }
+}
+
+// ============================================================================ extra players
+// Players 1..COOP_MAX_CLIENTS-1 are recorded into the replay stream so every machine runs them
+// identically:  type 12 = player joins  [long framePos][byte n]
+//               type 11 = player input  [long framePos][byte n][delta usercmd vs lastUsercmd]
+// Host: written + executed in SV_CoopUpdateExtraPlayers (right after player 0's input, inside
+// G_UpdatePlayer). Guest: read + executed by the replay reader at the same frame.
+#define COOP_DEMO_PLAYERCMD 11
+#define COOP_DEMO_JOIN 12
+#define COOP_DEMO_LEAVE 13 // player n left: removed at the same frame on every machine
+
+void SV_CheckDemoSize();        // sv_demo.cpp
+void SV_ReadNextDemoType();     // sv_demo.cpp
+
+static bool s_pendingJoin[COOP_MAX_CLIENTS];
+static usercmd_s s_netCmd[COOP_MAX_CLIENTS]; // idle input for local test clients
+// network players: every received command, run in order by the next host frame
+#define COOP_CMD_QUEUE 256
+static usercmd_s s_cmdQueue[COOP_MAX_CLIENTS][COOP_CMD_QUEUE];
+static int s_cmdHead[COOP_MAX_CLIENTS], s_cmdTail[COOP_MAX_CLIENTS];
+static bool s_isNetPlayer[COOP_MAX_CLIENTS];
+
+extern int g_coopBodyEnt;
+static void Coop_PlacePlayer(int n);
+static void Coop_GiveBody(int n);
+
+// a level (re)load wipes every entity: forget the extra players, they are re-added by a join
+// item (a checkpoint load does not go through SV_DirectConnect, which used to do this)
+void SV_CoopLevelReset()
+{
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        memset(&svs.clients[n], 0, sizeof(client_t));
+        s_pendingJoin[n] = false;
+        s_cmdHead[n] = s_cmdTail[n] = 0;
+    }
+    g_coopBodyEnt = -1;
+}
+
+static bool Coop_IsAlive(int n)
+{
+    if (svs.clients[n].state != 1)
+        return false;
+    const gclient_s *c = level.clients + n;
+    return c->ps.pm_type < PM_DEAD && SV_GentityNum(n)->health > 0;
+}
+
+// the first living player other than n (player 0 first), or -1 when nobody else is alive
+static int Coop_LivingOther(int n)
+{
+    for (int i = 0; i < COOP_MAX_CLIENTS; i++)
+    {
+        if (i != n && Coop_IsAlive(i))
+            return i;
+    }
+    return -1;
+}
+
+// who a (re)spawning player appears next to: a living partner (player 0 falls back to itself)
+static int Coop_AnchorFor(int n)
+{
+    int a = Coop_LivingOther(n);
+    return a >= 0 ? a : 0;
+}
+
+// co-op death rule (called from respawn(), same frame on every machine), the same for every player:
+// respawn beside a living partner; when nobody else is alive the whole team is down, and the normal
+// SP checkpoint reload happens (the host triggers it, guests follow through the stream).
+// Playing alone nobody else is alive, so this is exactly the original single-player behaviour.
+bool SV_CoopShouldRespawn(gentity_s *ent)
+{
+    if (atoi(Coop_Dvar("coop_nomercy"))) // test switch (host console): any death reloads the checkpoint
+        return false;
+    return Coop_LivingOther(ent->s.number) >= 0;
+}
+
+static void Coop_SpawnPlayer(int n)
+{
+    client_t *cl = &svs.clients[n];
+    memset(cl, 0, sizeof(*cl));
+    cl->gentity = SV_GentityNum(n);
+    cl->state = 1;
+    cl->lastUsercmd.serverTime = G_GetTime();
+    memset(&s_netCmd[n], 0, sizeof(s_netCmd[n]));
+    s_cmdHead[n] = s_cmdTail[n] = 0;
+
+    ClientConnect(n);
+    ClientBegin(n);
+    Coop_PlacePlayer(n);
+    Coop_GiveBody(n);
+    Coop_GiveBody(0); // a partner joined: the host needs a body too (does nothing if it has one)
+}
+
+#define COOP_PLAYER_BODY "body_complete_sp_sas_ct_benjamin"
+
+// Models can only be registered while a level initializes, so a body/weapon model must be one
+// the current map's scripts already loaded (cargoship has the sas_ct body, other maps do not).
+// Same configstring scan as G_ModelIndex, but without erroring when the model is missing.
+static const char *Coop_PrecachedModel(const char *wanted, const char *prefix)
+{
+    const char *firstPrefixMatch = 0;
+    for (int i = 1; i < 512; i++)
+    {
+        unsigned int cs = SV_GetConfigstringConst(i + 1123); // CS_MODELS (PC SP)
+        if (cs == scr_const._)
+            break;
+        const char *name = SL_ConvertToString(cs);
+        if (wanted && !I_stricmp(name, wanted))
+            return name;
+        if (prefix && !firstPrefixMatch && !I_strnicmp(name, prefix, (int)strlen(prefix)))
+            firstPrefixMatch = name;
+    }
+    return firstPrefixMatch;
+}
+
+static const char *Coop_Dvar(const char *name); // defined above
+
+static const char *Coop_BodyModel()
+{
+    // console override for experimenting: coop_body_model <name>
+    char want[96];
+    I_strncpyz(want, Coop_Dvar("coop_body_model"), sizeof(want));
+    if (*want)
+    {
+        const char *m = Coop_PrecachedModel(want, 0);
+        if (m)
+            return m;
+    }
+    // the usual soldier body if this map has it, else any full body model the map loaded
+    const char *m = Coop_PrecachedModel(COOP_PLAYER_BODY, "body_complete");
+    if (!m)
+        m = Coop_PrecachedModel(0, "body_");
+    static const char *lastLogged;
+    if (m && m != lastLogged)
+    {
+        lastLogged = m;
+        Com_Printf(CON_CHANNEL_SERVER, "COOP: player body model is '%s'\n", m);
+    }
+    return m;
+}
+
+// phase 3: give a player entity a third-person body so other machines can draw it
+// (server-side model + skeleton; the client copies the skeleton like for any script model)
+static int s_curAnim[COOP_MAX_CLIENTS];
+int g_coopBodyEnt = -1; // entity drawn as player 0's body (read by cgame, same process)
+float g_coopPlayerLean[64]; // lean (Q/E) of each drawn body, keyed by its entity number (read by cgame)
+
+// Player 0 is special-cased all over SP code and its anim weights get reset every frame, so its
+// visible body is a separate non-solid entity that follows it (created at the same frame on
+// every machine, so its entity number matches).
+static gentity_s *Coop_BodyEntFor(int n)
+{
+    if (n != 0)
+        return SV_GentityNum(n);
+    return g_coopBodyEnt >= 0 ? SV_GentityNum(g_coopBodyEnt) : 0;
+}
+
+static void Coop_GiveBody(int n)
+{
+    if (n == 0)
+    {
+        if (g_coopBodyEnt >= 0 && SV_GentityNum(g_coopBodyEnt)->r.inuse)
+            return;
+        gentity_s *body = G_Spawn();
+        body->s.eType = ET_GENERAL;
+        body->r.contents = 0; // shots and collisions belong to the real player
+        body->pAnimTree = Com_XAnimCreateSmallTree(g_scr_data.generic_human.tree.anims);
+        const char *bodyModel = Coop_BodyModel();
+        if (!bodyModel)
+        {
+            Com_Printf(CON_CHANNEL_SERVER, "COOP: this map has no body model to show players\n");
+            G_FreeEntity(body);
+            return;
+        }
+        G_SetModel(body, bodyModel);
+        G_DObjUpdate(body);
+        G_SetOrigin(body, SV_GentityNum(0)->r.currentOrigin);
+        SV_LinkEntity(body);
+        g_coopBodyEnt = body->s.number;
+        s_curAnim[0] = -1;
+        Com_Printf(CON_CHANNEL_SERVER, "COOP: player 0 body is entity %d\n", g_coopBodyEnt);
+        return;
+    }
+    gentity_s *ent = SV_GentityNum(n);
+    if (!ent->pAnimTree) // soldier animation set, as used by the AI
+        ent->pAnimTree = Com_XAnimCreateSmallTree(g_scr_data.generic_human.tree.anims);
+    const char *bodyModel = Coop_BodyModel();
+    if (bodyModel)
+    {
+        G_SetModel(ent, bodyModel);
+        G_DObjUpdate(ent);
+    }
+    s_curAnim[n] = -1;
+}
+
+// ---- body animation: chosen from each player's movement state, the same on every machine
+enum CoopAnim { CA_STAND, CA_WALK, CA_RUN, CA_CROUCH, CA_CROUCHWALK, CA_PRONE, CA_CRAWL, CA_ADS, CA_DEATH, CA_DEATH_CROUCH, CA_DEATH_PRONE,
+    CA_PISTOL, CA_RELOAD, CA_RELOAD_CROUCH, CA_RELOAD_PRONE, CA_PISTOL_RELOAD,
+    CA_THROW, CA_THROW_CROUCH, CA_THROW_PRONE, CA_MELEE, CA_MELEE_PRONE,
+    CA_PAIN, CA_PAIN_CROUCH, CA_PAIN_PRONE, CA_COUNT };
+static const char *s_animNames[CA_COUNT] = {
+    "exposed_aim_5", "walk_CQB_F", "run_lowready_F",
+    "exposed_crouch_aim_5", "crouch_fastwalk_F", "prone_aim_5", "prone_crawl", "CQB_stand_aim5",
+    "exposed_death", "exposed_crouch_death_flip", "prone_death_quickdeath",
+    "pistol_stand_aim_5", "exposed_reload", "exposed_crouch_reload", "prone_reload", "pistol_stand_reload_A",
+    "stand_grenade_throw", "crouch_grenade_throw", "prone_grenade_a", "melee_1", "melee_1",
+    "exposed_pain_right_arm", "exposed_crouch_pain_flinch", "prone_painA_holdchest",
+};
+// console overrides for experimenting: coop_anim_stand, coop_anim_walk, ...
+static const char *s_animDvars[CA_COUNT] = {
+    "coop_anim_stand", "coop_anim_walk", "coop_anim_run",
+    "coop_anim_crouch", "coop_anim_crouchwalk", "coop_anim_prone", "coop_anim_crawl", "coop_anim_ads",
+    "coop_anim_death", "coop_anim_death_crouch", "coop_anim_death_prone",
+    "coop_anim_pistol", "coop_anim_reload", "coop_anim_reload_crouch", "coop_anim_reload_prone", "coop_anim_pistol_reload",
+    "coop_anim_throw", "coop_anim_throw_crouch", "coop_anim_throw_prone", "coop_anim_melee", "coop_anim_melee_prone",
+    "coop_anim_pain", "coop_anim_pain_crouch", "coop_anim_pain_prone",
+};
+static int s_animIndex[CA_COUNT];
+static char s_animUsed[CA_COUNT][64];
+static const XAnim_s *s_animIndexFor;
+
+static void Coop_ResolveAnims(const XAnim_s *anims)
+{
+    bool changed = s_animIndexFor != anims;
+    for (int a = 0; a < CA_COUNT && !changed; a++)
+    {
+        const char *want = *Coop_Dvar(s_animDvars[a]) ? Coop_Dvar(s_animDvars[a]) : s_animNames[a];
+        changed = strcmp(want, s_animUsed[a]) != 0;
+    }
+    if (!changed)
+        return;
+    s_animIndexFor = anims;
+    for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+        s_curAnim[n] = -1; // re-apply with the new names
+    for (int a = 0; a < CA_COUNT; a++)
+    {
+        const char *want = *Coop_Dvar(s_animDvars[a]) ? Coop_Dvar(s_animDvars[a]) : s_animNames[a];
+        I_strncpyz(s_animUsed[a], want, sizeof(s_animUsed[a]));
+        s_animIndex[a] = -1;
+        for (unsigned int i = 0; i < anims->size; i++)
+        {
+            const char *name = XAnimGetAnimDebugName(anims, i);
+            if (name && !_stricmp(name, s_animUsed[a]))
+            {
+                s_animIndex[a] = i;
+                break;
+            }
+        }
+        if (s_animIndex[a] < 0)
+            Com_Printf(CON_CHANNEL_SERVER, "COOP: body anim '%s' not in generic_human\n", s_animUsed[a]);
+        else
+            Com_Printf(CON_CHANNEL_SERVER, "COOP: body anim %s = %s\n", s_animDvars[a], s_animUsed[a]);
+    }
+}
+
+// weapon in hand: attach the current weapon's world model to the right-hand tag whenever
+// the player's weapon changes (deterministic, so every machine does the same)
+static int s_heldWeapon[COOP_MAX_CLIENTS];
+static void Coop_UpdateHeldWeapon(int n, gentity_s *ent, const playerState_s *ps)
+{
+    if (s_curAnim[n] < 0 && s_heldWeapon[n] != -1)
+        s_heldWeapon[n] = -1; // body was (re)created: attach afresh
+    if (s_heldWeapon[n] == (int)ps->weapon)
+        return;
+    s_heldWeapon[n] = ps->weapon;
+    s_curAnim[n] = -1; // attaching rebuilds the DObj: the pose must be applied again
+    G_EntDetachAll(ent);
+    if (!ps->weapon)
+        return;
+    const WeaponDef *def = BG_GetWeaponDef(ps->weapon);
+    if (!def || !def->worldModel[0] || XModelBad(def->worldModel[0]))
+        return;
+    const char *name = XModelGetName(def->worldModel[0]);
+    if (!Coop_PrecachedModel(name, 0)) // this map never loaded that weapon's world model
+        return;
+    if (!G_EntAttach(ent, name, scr_const.tag_weapon_right, 0))
+        Com_Printf(CON_CHANNEL_SERVER, "COOP: could not attach %s to p%d\n", name, n);
+}
+
+// called before G_RunFrame on every machine
+void SV_CoopAnimatePlayers()
+{
+    bool session = false;
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+        session |= svs.clients[n].state == 1;
+    if (!session || !sv.state)
+        return;
+
+    for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+    {
+        if (svs.clients[n].state != 1)
+            continue;
+        gentity_s *ent = Coop_BodyEntFor(n);
+        if (!ent || !ent->model || !ent->pAnimTree)
+            continue;
+        if (n == 0)
+        {
+            // follow player 0: position + view angles (pitch is bent into the spine by cgame)
+            const playerState_s *ps0 = &level.clients[0].ps;
+            float ang[3] = { ps0->pm_type >= PM_DEAD ? 0.0f : ps0->viewangles[0], ps0->viewangles[1], 0.0f };
+            G_SetOrigin(ent, (float *)ps0->origin);
+            G_SetAngle(ent, ang);
+            SV_LinkEntity(ent);
+        }
+        DObj_s *obj = Com_GetServerDObj(ent->s.number);
+        if (!obj)
+            continue;
+        Coop_ResolveAnims(XAnimGetAnims(ent->pAnimTree));
+
+        const playerState_s *ps = &level.clients[n].ps;
+        g_coopPlayerLean[ent->s.number & 63] = ps->leanf;
+        if (ps->pm_type >= PM_DEAD)
+        {
+            // fall down once, in the pose matching the stance they died in, and stay there
+            int deathAnim = (ps->pm_flags & PMF_PRONE) ? CA_DEATH_PRONE : (ps->pm_flags & PMF_DUCKED) ? CA_DEATH_CROUCH : CA_DEATH;
+            if (s_curAnim[n] != CA_DEATH && s_curAnim[n] != CA_DEATH_CROUCH && s_curAnim[n] != CA_DEATH_PRONE && s_animIndex[deathAnim] >= 0)
+            {
+                int cur = s_curAnim[n];
+                if (cur >= 0 && s_animIndex[cur] >= 0)
+                    XAnimSetGoalWeight(obj, s_animIndex[cur], 0.0f, 0.2f, 1.0f, 0, 0, 0);
+                XAnimSetTime(ent->pAnimTree, s_animIndex[deathAnim], 0.0f); // play from the start, not the end of an earlier death
+                XAnimSetCompleteGoalWeight(obj, s_animIndex[deathAnim], 1.0f, 0.1f, 1.0f, 0, 0, 0);
+                s_curAnim[n] = deathAnim;
+            }
+            ent->flags |= FL_REPEAT_ANIM_UPDATE;
+            continue;
+        }
+        Coop_UpdateHeldWeapon(n, ent, ps);
+        obj = Com_GetServerDObj(ent->s.number); // may have been rebuilt by the attach
+        if (!obj)
+            continue;
+        // horizontal speed from how far the player actually moved since the last frame
+        // (ps->velocity reads 0 here)
+        static float prevOrg[COOP_MAX_CLIENTS][2];
+        static int prevTime[COOP_MAX_CLIENTS];
+        float speed = 0.0f;
+        int dt = level.time - prevTime[n];
+        if (dt == 0 && s_curAnim[n] >= 0)
+            continue; // called again within the same level frame: keep the current anim
+        if (dt > 0 && dt < 500)
+        {
+            float dx = ps->origin[0] - prevOrg[n][0], dy = ps->origin[1] - prevOrg[n][1];
+            speed = sqrtf(dx * dx + dy * dy) * 1000.0f / dt;
+        }
+        prevOrg[n][0] = ps->origin[0];
+        prevOrg[n][1] = ps->origin[1];
+        prevTime[n] = level.time;
+        // hysteresis: a speed hovering at a threshold must not flip the anim every frame
+        int cur = s_curAnim[n];
+        bool wasMoving = cur == CA_WALK || cur == CA_RUN || cur == CA_CROUCHWALK || cur == CA_CRAWL;
+        bool moving = speed > (wasMoving ? 15.0f : 30.0f);
+        int anim;
+        float rate = 1.0f;
+        if (ps->pm_flags & PMF_PRONE)
+            anim = moving ? CA_CRAWL : CA_PRONE;
+        else if (ps->pm_flags & PMF_DUCKED)
+            anim = moving ? CA_CROUCHWALK : CA_CROUCH;
+        else if (moving && speed > (cur == CA_RUN ? 110.0f : 150.0f))
+        {
+            anim = CA_RUN;
+            rate = speed / 190.0f; // the run cycle covers ~190 units/s
+        }
+        else if (moving)
+            anim = CA_WALK;
+        else if (ps->fWeaponPosFrac >= 0.9f)
+            anim = CA_ADS; // aiming down sights while standing still
+        else
+            anim = CA_STAND;
+
+        // hit reaction: remember when health dropped, flinch for a moment
+        static int prevHealth[COOP_MAX_CLIENTS], painUntil[COOP_MAX_CLIENTS];
+        int health = ps->stats[STAT_HEALTH];
+        if (cur >= 0 && health < prevHealth[n] && health > 0)
+            painUntil[n] = level.time + 400;
+        prevHealth[n] = health;
+
+        // weapon class and what the weapon is doing right now (reload / grenade / knife)
+        const WeaponDef *wdef = ps->weapon ? BG_GetWeaponDef(ps->weapon) : 0;
+        bool pistol = wdef && wdef->weapClass == WEAPCLASS_PISTOL;
+        bool prone = (ps->pm_flags & PMF_PRONE) != 0, ducked = (ps->pm_flags & PMF_DUCKED) != 0;
+        int ws = ps->weaponstate;
+        bool action = true;
+        if (ws >= WEAPON_OFFHAND_INIT && ws <= WEAPON_OFFHAND_END)
+            anim = prone ? CA_THROW_PRONE : ducked ? CA_THROW_CROUCH : CA_THROW;
+        else if (ws >= WEAPON_MELEE_INIT && ws <= WEAPON_MELEE_END)
+            anim = prone ? CA_MELEE_PRONE : CA_MELEE;
+        else if (ws >= WEAPON_RELOADING && ws <= WEAPON_RELOAD_END)
+            anim = pistol && !prone && !ducked ? CA_PISTOL_RELOAD : prone ? CA_RELOAD_PRONE : ducked ? CA_RELOAD_CROUCH : CA_RELOAD;
+        else
+        {
+            action = false;
+            if (pistol && (anim == CA_STAND || anim == CA_ADS))
+                anim = CA_PISTOL;
+            if (level.time < painUntil[n]) // flinch, but never over a reload / throw / knife
+            {
+                anim = prone ? CA_PAIN_PRONE : ducked ? CA_PAIN_CROUCH : CA_PAIN;
+                action = true;
+            }
+        }
+
+        static int lastLog;
+        if (atoi(Coop_Dvar("coop_debug")) && (level.time - lastLog > 1000 || level.time < lastLog)) // +set coop_debug 1
+        {
+            if (n == COOP_MAX_CLIENTS - 1 || svs.clients[n + 1].state != 1)
+                lastLog = level.time;
+            int ci = s_curAnim[n] >= 0 ? s_animIndex[s_curAnim[n]] : -1;
+            Com_Printf(CON_CHANNEL_SERVER, "COOP-ANIM: p%d tree %s model %d scripted %d | ", n,
+                DObjGetTree(obj) == ent->pAnimTree ? "ok" : (DObjGetTree(obj) ? "OTHER" : "NONE"), ent->model, ent->scripted != 0);
+            Com_Printf(CON_CHANNEL_SERVER, "p%d speed %.0f flags 0x%x -> %s | cur time %.2f w %.2f, crouch w %.2f, stand w %.2f\n",
+                n, speed, ps->pm_flags, s_animUsed[anim],
+                ci >= 0 ? XAnimGetTime(ent->pAnimTree, ci) : -1.0,
+                ci >= 0 ? XAnimGetWeight(ent->pAnimTree, ci) : -1.0,
+                s_animIndex[CA_CROUCH] >= 0 ? XAnimGetWeight(ent->pAnimTree, s_animIndex[CA_CROUCH]) : -1.0,
+                s_animIndex[CA_STAND] >= 0 ? XAnimGetWeight(ent->pAnimTree, s_animIndex[CA_STAND]) : -1.0);
+        }
+
+        if (anim != s_curAnim[n] && s_animIndex[anim] >= 0)
+        {
+            // fade the previous pose out explicitly: it may live in another branch of the
+            // tree, where "complete goal weight" doesn't reach (crouch stayed after standing up)
+            if (cur >= 0 && s_animIndex[cur] >= 0)
+                XAnimSetGoalWeight(obj, s_animIndex[cur], 0.0f, 0.2f, 1.0f, 0, 0, 0);
+            else if (cur < 0)
+            {
+                // fresh start (spawn / respawn / new weapon model): nothing is known to be playing, so
+                // fade out every pose, or a death pose would stay under the new one
+                for (int a = 0; a < CA_COUNT; a++)
+                    if (a != anim && s_animIndex[a] >= 0)
+                        XAnimSetGoalWeight(obj, s_animIndex[a], 0.0f, 0.1f, 1.0f, 0, 0, 0);
+            }
+            if (action)
+                XAnimSetTime(ent->pAnimTree, s_animIndex[anim], 0.0f); // play the action from its start
+            int err = XAnimSetCompleteGoalWeight(obj, s_animIndex[anim], 1.0f, action ? 0.1f : 0.2f, rate, 0, 0, 0);
+            if (err)
+                Com_Printf(CON_CHANNEL_SERVER, "COOP-ANIM: p%d set %s failed (error %d)\n", n, s_animUsed[anim], err);
+            s_curAnim[n] = anim;
+        }
+        ent->flags |= FL_REPEAT_ANIM_UPDATE;
+    }
+}
+
+// a free player-sized spot near the anchor: sweep a player box out from the anchor in a fixed
+// order of directions/distances (same result on every machine), skip anything blocked, then
+// drop to the floor. Falls back to the anchor's own position.
+static void Coop_FindSpot(gentity_s *anchor, float *out)
+{
+    static const float dist[] = { 48.0f, 80.0f, 120.0f };
+    static const float dirs[8][2] = {
+        { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 },
+        { 0.7071f, 0.7071f }, { -0.7071f, 0.7071f }, { 0.7071f, -0.7071f }, { -0.7071f, -0.7071f },
+    };
+    const float *a = anchor->r.currentOrigin;
+    float from[3] = { a[0], a[1], a[2] + 18.0f }; // a little up, clear of steps
+    for (int d = 0; d < 3; d++)
+    {
+        for (int i = 0; i < 8; i++)
+        {
+            float to[3] = { a[0] + dirs[i][0] * dist[d], a[1] + dirs[i][1] * dist[d], from[2] };
+            trace_t tr;
+            G_TraceCapsule(&tr, from, playerMins, playerMaxs, to, anchor->s.number, MASK_PLAYERSOLID);
+            if (tr.startsolid || tr.allsolid || tr.fraction < 1.0f)
+                continue; // wall, crate, another player, or a different room
+            float down[3] = { to[0], to[1], to[2] - 128.0f };
+            G_TraceCapsule(&tr, to, playerMins, playerMaxs, down, anchor->s.number, MASK_PLAYERSOLID);
+            if (tr.startsolid || tr.allsolid || tr.fraction >= 1.0f)
+                continue; // no floor (ledge, water)
+            float floorZ = to[2] + (down[2] - to[2]) * tr.fraction;
+            if (to[2] - floorZ > 40.0f)
+                continue; // a drop, not ground at our level
+            // not at an edge: ground must be close below on all four sides too
+            bool edge = false;
+            static const float side[4][2] = { { 28, 0 }, { -28, 0 }, { 0, 28 }, { 0, -28 } };
+            for (int k = 0; k < 4 && !edge; k++)
+            {
+                float sf[3] = { to[0] + side[k][0], to[1] + side[k][1], to[2] };
+                float sd[3] = { sf[0], sf[1], to[2] - 64.0f };
+                trace_t st;
+                G_TraceCapsule(&st, sf, playerMins, playerMaxs, sd, anchor->s.number, MASK_PLAYERSOLID);
+                edge = st.fraction >= 1.0f;
+            }
+            if (edge)
+                continue;
+            out[0] = to[0];
+            out[1] = to[1];
+            out[2] = floorZ;
+            return;
+        }
+    }
+    out[0] = a[0];
+    out[1] = a[1];
+    out[2] = a[2];
+}
+
+// put player n beside player 0 with player 0's loadout (spawn and respawn)
+static void Coop_PlacePlayer(int n)
+{
+    gentity_s *ent = SV_GentityNum(n);
+    gentity_s *host = SV_GentityNum(Coop_AnchorFor(n));
+    float org[3];
+    Coop_FindSpot(host, org);
+    G_SetOrigin(ent, org);
+    ent->client->ps.origin[0] = org[0];
+    ent->client->ps.origin[1] = org[1];
+    ent->client->ps.origin[2] = org[2];
+    SV_LinkEntity(ent);
+
+    // same loadout as player 0 (identical on every machine: done from replayed state)
+    playerState_s *ps = &ent->client->ps;
+    const playerState_s *ps0 = &host->client->ps;
+    for (int w = 1; w < 128; w++)
+    {
+        if (ps0->weapons[w >> 5] & (1u << (w & 31)))
+            G_GivePlayerWeapon(ps, w, 0);
+    }
+    memcpy(ps->ammo, ps0->ammo, sizeof(ps->ammo));
+    memcpy(ps->ammoclip, ps0->ammoclip, sizeof(ps->ammoclip));
+    ps->offHandIndex = ps0->offHandIndex;
+    ps->offhandSecondary = ps0->offhandSecondary;
+    ps->weapon = ps0->weapon;
+
+    // guest: start looking along the spawn direction (our view angles were following player 0's replay)
+    if (s_gstate == GUEST_FOLLOWING && n == 1)
+    {
+        clients[0].viewangles[0] = 0.0f;
+        clients[0].viewangles[1] = 0.0f;
+        clients[0].viewangles[2] = 0.0f;
+    }
+
+    Com_Printf(CON_CHANNEL_SERVER, "COOP: player %d spawned at (%.0f %.0f %.0f) frame %d\n",
+        n, org[0], org[1], org[2], G_GetFramePos());
+}
+
+// queue the next free slot to join at the next frame (host only; guests get joins from the stream)
+int SV_CoopQueueJoin()
+{
+    if (sv.demo.playing)
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP: players can only be added on the host\n");
+        return -1;
+    }
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        if (!svs.clients[n].state && !s_pendingJoin[n])
+        {
+            s_pendingJoin[n] = true;
+            return n;
+        }
+    }
+    Com_Printf(CON_CHANNEL_SERVER, "COOP: all %d player slots in use\n", COOP_MAX_CLIENTS);
+    return -1;
+}
+
+void SV_CoopSetNetCmd(int n, const usercmd_s *cmd)
+{
+    s_isNetPlayer[n] = true;
+    int next = (s_cmdHead[n] + 1) % COOP_CMD_QUEUE;
+    if (next == s_cmdTail[n])
+        s_cmdTail[n] = (s_cmdTail[n] + 1) % COOP_CMD_QUEUE; // full: drop oldest
+    s_cmdQueue[n][s_cmdHead[n]] = *cmd;
+    s_cmdHead[n] = next;
+}
+
+static void Coop_RecordAndRunCmd(int n, int framePos, usercmd_s *cmd)
+{
+    client_t *cl = &svs.clients[n];
+    if (sv.demo.recording)
+    {
+        SV_CheckDemoSize();
+        MSG_WriteByte(&sv.demo.msg, COOP_DEMO_PLAYERCMD);
+        MSG_WriteLong(&sv.demo.msg, framePos);
+        MSG_WriteByte(&sv.demo.msg, n);
+        MSG_WriteDeltaUsercmd(&sv.demo.msg, &cl->lastUsercmd, cmd);
+    }
+    cl->lastUsercmd = *cmd;
+    ClientThink(n);
+}
+
+// a player left: take their entity out of the world (the slot stays reserved for players)
+static void Coop_RemovePlayer(int n)
+{
+    gentity_s *ent = SV_GentityNum(n);
+    Coop_Announce(va("%s left", Coop_NameOf(n)));
+    s_playerName[n] = -1;
+    if (ent->r.inuse)
+    {
+        if (ent->sentient)
+            Sentient_Free(ent->sentient);
+        SV_UnlinkEntity(ent);
+        ent->r.inuse = 0;
+    }
+    level.clients[n].pers.connected = CON_DISCONNECTED;
+    memset(&svs.clients[n], 0, sizeof(client_t));
+    s_isNetPlayer[n] = false;
+    s_pendingJoin[n] = false;
+    s_cmdHead[n] = s_cmdTail[n] = 0;
+    Com_Printf(CON_CHANNEL_SERVER, "COOP: player %d left at frame %d\n", n, G_GetFramePos());
+}
+
+void SV_CoopUpdateExtraPlayers()
+{
+    int framePos = G_GetFramePos();
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        if (!s_pendingLeave[n])
+            continue;
+        s_pendingLeave[n] = false;
+        s_pendingJoin[n] = false;
+        if (svs.clients[n].state != 1)
+            continue;
+        if (sv.demo.recording)
+        {
+            SV_CheckDemoSize();
+            MSG_WriteByte(&sv.demo.msg, COOP_DEMO_LEAVE);
+            MSG_WriteLong(&sv.demo.msg, framePos);
+            MSG_WriteByte(&sv.demo.msg, n);
+        }
+        Coop_RemovePlayer(n);
+    }
+    // a connected guest gets a player once player 0 stands on something and moves freely
+    // (not during intros like the cargoship helicopter ride)
+    for (int i = 0; i < COOP_MAX_GUESTS; i++)
+    {
+        CoopGuestConn &c = s_guests[i];
+        if (!c.used || !c.wantsJoin)
+            continue;
+        const playerState_s *ps0 = &level.clients[0].ps;
+        if (ps0->pm_type == PM_NORMAL && ps0->groundEntityNum != ENTITYNUM_NONE)
+        {
+            if (!svs.clients[c.slot].state && !s_pendingJoin[c.slot])
+            {
+                s_pendingJoin[c.slot] = true;
+                s_pendingAnnounce[c.slot] = c.announceJoin;
+                c.announceJoin = false;
+                s_playerName[c.slot] = c.nameIndex;
+                Com_Printf(CON_CHANNEL_SERVER, "COOP-HOST: guest becomes player %d\n", c.slot);
+            }
+            c.wantsJoin = false;
+        }
+    }
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        if (!s_pendingJoin[n])
+            continue;
+        s_pendingJoin[n] = false;
+        if (sv.demo.recording)
+        {
+            SV_CheckDemoSize();
+            MSG_WriteByte(&sv.demo.msg, COOP_DEMO_JOIN);
+            MSG_WriteLong(&sv.demo.msg, framePos);
+            MSG_WriteByte(&sv.demo.msg, n);
+            // callsign index, top bit = say "joined" on screen
+            MSG_WriteByte(&sv.demo.msg, (s_playerName[n] >= 0 ? s_playerName[n] : 0) | (s_pendingAnnounce[n] ? 0x80 : 0));
+        }
+        Coop_SpawnPlayer(n);
+        if (s_pendingAnnounce[n])
+            Coop_Announce(va("%s joined", Coop_NameOf(n)));
+        s_pendingAnnounce[n] = false;
+    }
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        client_t *cl = &svs.clients[n];
+        if (cl->state != 1)
+            continue;
+        if (!s_isNetPlayer[n])
+        {
+            // local test client: one idle command on the host's clock
+            usercmd_s cmd = s_netCmd[n];
+            cmd.serverTime = G_GetTime();
+            Coop_RecordAndRunCmd(n, framePos, &cmd);
+            continue;
+        }
+        // network player: run every queued command in order, on the guest's own clock
+        int now = G_GetTime();
+        while (s_cmdTail[n] != s_cmdHead[n])
+        {
+            usercmd_s cmd = s_cmdQueue[n][s_cmdTail[n]];
+            s_cmdTail[n] = (s_cmdTail[n] + 1) % COOP_CMD_QUEUE;
+            if (cmd.serverTime <= cl->lastUsercmd.serverTime)
+                continue; // stale or duplicate
+            if (cmd.serverTime > now)
+                cmd.serverTime = now;
+            Coop_RecordAndRunCmd(n, framePos, &cmd);
+        }
+    }
+}
+
+// replay reader: handles our item types (readType already consumed incl. framePos)
+bool SV_CoopReadDemoItem(int type)
+{
+    if (type != COOP_DEMO_PLAYERCMD && type != COOP_DEMO_JOIN && type != COOP_DEMO_LEAVE)
+        return false;
+    int n = MSG_ReadByte(&sv.demo.msg);
+    if (n < 1 || n >= COOP_MAX_CLIENTS)
+    {
+        Com_Printf(CON_CHANNEL_SERVER, "COOP: bad player %d in replay stream\n", n);
+        n = 1;
+    }
+    if (type == COOP_DEMO_LEAVE)
+    {
+        SV_ReadNextDemoType();
+        Coop_RemovePlayer(n);
+        return true;
+    }
+    if (type == COOP_DEMO_JOIN)
+    {
+        int nameByte = MSG_ReadByte(&sv.demo.msg);
+        SV_ReadNextDemoType();
+        s_playerName[n] = nameByte & 0x7F;
+        Coop_SpawnPlayer(n);
+        if (nameByte & 0x80)
+            Coop_Announce(va("%s joined", Coop_NameOf(n)));
+        return true;
+    }
+    usercmd_s cmd;
+    MSG_ReadDeltaUsercmd(&sv.demo.msg, &svs.clients[n].lastUsercmd, &cmd);
+    SV_ReadNextDemoType();
+    if (svs.clients[n].state == 1)
+    {
+        svs.clients[n].lastUsercmd = cmd;
+        ClientThink(n);
+    }
+    return true;
+}
+
+// which player this machine's screen shows: the guest follows player 1 once it exists;
+// "+set coop_view N" overrides (handy for testing on the host)
+int SV_CoopViewClient()
+{
+    const char *v = Coop_Dvar("coop_view");
+    if (*v)
+    {
+        int n = atoi(v);
+        if (n >= 0 && n < COOP_MAX_CLIENTS && svs.clients[n].state == 1)
+            return n;
+        return 0;
+    }
+    if (s_gstate == GUEST_FOLLOWING && svs.clients[s_mySlot].state == 1)
+        return s_mySlot;
+    return 0;
+}
+
+// after the level was restored from a snapshot: the save holds the players' entities, but not the
+// engine-side client records or each player's last input (the replay decodes inputs as deltas from it)
+static void Coop_ApplySnapshotFix()
+{
+    s_snapFixPending = false;
+    for (int n = 1; n < COOP_MAX_CLIENTS; n++)
+    {
+        client_t *cl = &svs.clients[n];
+        memset(cl, 0, sizeof(*cl));
+        if (!s_snapFix.active[n])
+            continue;
+        cl->gentity = SV_GentityNum(n);
+        cl->state = 1;
+        cl->lastUsercmd = s_snapFix.cmd[n];
+        s_playerName[n] = s_snapFix.name[n];
+        Coop_GiveBody(n); // animation tree / model for the restored player entity
+    }
+    g_coopBodyEnt = s_snapFix.bodyEnt;
+    if (g_coopBodyEnt >= 0)
+    {
+        gentity_s *b = SV_GentityNum(g_coopBodyEnt);
+        if (b->r.inuse)
+        {
+            if (!b->pAnimTree)
+                b->pAnimTree = Com_XAnimCreateSmallTree(g_scr_data.generic_human.tree.anims);
+            const char *bodyModel = Coop_BodyModel();
+            if (bodyModel)
+                G_SetModel(b, bodyModel);
+            G_DObjUpdate(b);
+            s_curAnim[0] = -1;
+        }
+    }
+    Com_Printf(CON_CHANNEL_SERVER, "COOP-GUEST: snapshot restored (body entity %d)\n", g_coopBodyEnt);
+}
+
+// a guest is connected to this host: the victory screen then moves on to the next map by itself
+bool SV_CoopHostHasGuest()
+{
+    for (int i = 0; i < COOP_MAX_GUESTS; i++)
+        if (s_guests[i].used)
+            return true;
+    return false;
+}
+
+bool SV_CoopIsGuest()
+{
+    return s_gstate == GUEST_FOLLOWING;
+}
+
+// called from respawn() when an extra player's death delay ran out (same frame on every machine):
+// co-op rule - extra players respawn beside player 0 instead of reloading the checkpoint
+void SV_CoopRespawnPlayer(gentity_s *ent)
+{
+    int n = ent->s.number;
+    ent->handler = ENT_HANDLER_CLIENT; // death switched it to ENT_HANDLER_CLIENT_DEAD (SP never revives)
+    ClientSpawn(ent);
+    Coop_PlacePlayer(n);
+    Coop_GiveBody(n);
+    Com_Printf(CON_CHANNEL_SERVER, "COOP: player %d respawned at frame %d\n", n, G_GetFramePos());
+}
