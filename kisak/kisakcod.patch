+// COOP: players and AI share one pool of 33 "awareness" records (a player that cannot get one fails to join
+// with an error). In a co-op game keep a record free for every player that may still join: no new AI while
+// the pool is that full. Depends only on saved state (coop_maxplayers, who is connected), so every machine
+// decides the same. Solo play (coop_maxplayers 1) is not affected.
+static bool Coop_SentientPoolTight()
+{
+    int maxPlayers = Dvar_GetInt("coop_maxplayers");
+    if (maxPlayers < 2)
+        return false;
+    int used = 0, players = 0;
+    for (int i = 0; i < 33; i++)
+        used += level.sentients[i].inuse != 0;
+    for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+        players += level.clients[n].pers.connected == CON_CONNECTED;
+    int reserve = maxPlayers - players;
+    if (reserve < 0)
+        reserve = 0;
+    return used + reserve >= 33;
+}
