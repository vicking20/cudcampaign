+// ---- COOP: native gamepad (XInput), see win32/win_coop_gamepad.cpp
+struct CoopPadState
+{
+    float lx, ly, rx, ry, lt, rt;
+    unsigned short buttons;
+};
+bool Coop_PadRead(CoopPadState *out);
+
+namespace
+{
+// Buttons run the same console commands a keyboard binding would, so every game rule (stance toggles,
+// sprint, ADS, ...) is reused. Only the sticks are handled directly.
+struct PadBinding { unsigned short mask; const char *down, *up; bool was; };
+PadBinding s_padButtons[] = {
+    { 0x1000, "+gostand", "-gostand", false },         // A: jump
+    { 0x2000, "togglecrouch", 0, false },              // B: crouch / stand
+    { 0x4000, "+usereload", "-usereload", false },     // X: use / reload
+    { 0x8000, "weapnext", 0, false },                  // Y: next weapon
+    { 0x0100, "+frag", "-frag", false },               // LB: frag grenade
+    { 0x0200, "+smoke", "-smoke", false },             // RB: flash / smoke
+    { 0x0040, "+sprint", "-sprint", false },           // left stick click: sprint
+    { 0x0080, "+melee", "-melee", false },             // right stick click: melee
+    { 0x0004, "+leanleft", "-leanleft", false },       // d-pad left: lean left
+    { 0x0008, "+leanright", "-leanright", false },     // d-pad right: lean right
+    { 0x0002, "toggleprone", 0, false },               // d-pad down: prone
+    { 0x0001, "+nightvision", "-nightvision", false }, // d-pad up: night vision
+};
+bool s_padAttack, s_padAds;
+
+void PadEdge(bool now, bool *was, const char *down, const char *up)
+{
+    if (now == *was)
+        return;
+    *was = now;
+    const char *cmd = now ? down : up;
+    if (cmd)
+        Cbuf_AddText(0, va("%s\n", cmd));
+}
+
+void PadReleaseAll()
+{
+    for (PadBinding &b : s_padButtons)
+        PadEdge(false, &b.was, b.down, b.up);
+    PadEdge(false, &s_padAttack, "+attack", "-attack");
+    PadEdge(false, &s_padAds, "+speed_throw", "-speed_throw");
+}
+
+float PadDvar(const char *name, float def)
+{
+    const dvar_s *d = Dvar_FindVar(name);
+    return (d && *Dvar_DisplayableValue(d)) ? (float)atof(Dvar_DisplayableValue(d)) : def;
+}
+
+// radial dead zone, rescaled so the stick still reaches 1.0, then a curve for fine aiming
+void PadStick(float x, float y, float dead, float *ox, float *oy, float curve)
+{
+    float m = sqrtf(x * x + y * y);
+    if (m < dead)
+    {
+        *ox = *oy = 0.0f;
+        return;
+    }
+    float scaled = (m - dead) / (1.0f - dead);
+    if (scaled > 1.0f)
+        scaled = 1.0f;
+    float shaped = powf(scaled, curve);
+    *ox = x / m * shaped;
+    *oy = y / m * shaped;
+}
+
+void CL_CoopGamepadMove(usercmd_s *cmd)
+{
+    CoopPadState p;
+    if (!Coop_PadRead(&p) || Key_IsCatcherActive(0, KEYCATCH_UI))
+    {
+        PadReleaseAll(); // no pad, or a menu is open: let go of everything
+        return;
+    }
+    for (PadBinding &b : s_padButtons)
+        PadEdge((p.buttons & b.mask) != 0, &b.was, b.down, b.up);
+    PadEdge(p.rt > 0.5f, &s_padAttack, "+attack", "-attack");
+    PadEdge(p.lt > 0.5f, &s_padAds, "+speed_throw", "-speed_throw");
+
+    // movement (left stick)
+    float mx, my;
+    PadStick(p.lx, p.ly, 0.24f, &mx, &my, 1.0f);
+    cmd->forwardmove = ClampChar(cmd->forwardmove + (int)(my * 127.0f));
+    cmd->rightmove = ClampChar(cmd->rightmove + (int)(mx * 127.0f));
+
+    // aiming (right stick): degrees per second at full deflection; slower while aiming down sights
+    float ax, ay;
+    PadStick(p.rx, p.ry, 0.18f, &ax, &ay, 1.7f);
+    float yawRate = PadDvar("pad_yawspeed", 300.0f), pitchRate = PadDvar("pad_pitchspeed", 200.0f);
+    if (kb[KEY_SPEED].active)
+    {
+        yawRate *= 0.6f;
+        pitchRate *= 0.6f;
+    }
+    float dt = frame_msec * 0.001f;
+    clients[0].viewangles[YAW] -= ax * yawRate * dt;
+    clients[0].viewangles[PITCH] -= ay * pitchRate * dt * (PadDvar("pad_invert", 0.0f) != 0.0f ? -1.0f : 1.0f);
+}
