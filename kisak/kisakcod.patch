+// An extra enemy has no mission script to give it a goal, so it would stand where it spawned: send it after the
+// nearest living player. Uses only game state, so every machine picks the same player.
+static void Coop_SendCloneAfterPlayer(gentity_s *clone)
+{
+    gentity_s *best = 0;
+    float bestDist = 0.0f;
+    for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+    {
+        gentity_s *pl = &g_entities[n];
+        if (!pl->r.inuse || !pl->client || pl->health <= 0 || level.clients[n].ps.pm_type >= PM_DEAD)
+            continue;
+        float dx = pl->r.currentOrigin[0] - clone->r.currentOrigin[0];
+        float dy = pl->r.currentOrigin[1] - clone->r.currentOrigin[1];
+        float d = dx * dx + dy * dy;
+        if (!best || d < bestDist)
+        {
+            best = pl;
+            bestDist = d;
+        }
+    }
+    if (best)
+    {
+        Actor_SetScriptGoalEntity(clone->actor, best);
+        Actor_SetGoalRadius(&clone->actor->scriptGoal, 700.0f);
+    }
+}
