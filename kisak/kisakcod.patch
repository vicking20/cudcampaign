diff --git a/src/win32/win_coop_gamepad.cpp b/src/win32/win_coop_gamepad.cpp
new file mode 100644
index 0000000..0db1b32
--- /dev/null
+++ b/src/win32/win_coop_gamepad.cpp
@@ -0,0 +1,75 @@
+// COOP: native gamepad (XInput) reader. The game itself has no controller support on PC; cl_input.cpp
+// (CL_CoopGamepadMove) turns this state into movement, aiming and key commands.
+// XInput is loaded at run time (xinput1_4 / 1_3 / 9_1_0 - Wine provides these too), so nothing is linked
+// and the game starts exactly as before when no controller is plugged in.
+#include <windows.h>
+
+struct CoopPadState
+{
+    float lx, ly, rx, ry;      // sticks, -1..1 (up/right positive)
+    float lt, rt;              // triggers, 0..1
+    unsigned short buttons;    // XInput button bits
+};
+
+namespace
+{
+struct XPad { unsigned short buttons; unsigned char lt, rt; short lx, ly, rx, ry; };
+struct XState { DWORD packet; XPad pad; };
+typedef DWORD(WINAPI *XInputGetStateFn)(DWORD, XState *);
+
+XInputGetStateFn s_get;
+bool s_loaded;
+int s_user = -1;          // controller index in use, -1 = none found
+DWORD s_nextScan;
+
+float Norm(short v)
+{
+    float f = v / 32767.0f;
+    return f < -1.0f ? -1.0f : f;
+}
+} // namespace
+
+bool Coop_PadRead(CoopPadState *out)
+{
+    if (!s_loaded)
+    {
+        s_loaded = true;
+        static const char *dlls[] = { "xinput1_4.dll", "xinput1_3.dll", "xinput9_1_0.dll" };
+        for (const char *d : dlls)
+        {
+            HMODULE m = LoadLibraryA(d);
+            if (m && (s_get = (XInputGetStateFn)GetProcAddress(m, "XInputGetState")))
+                break;
+        }
+    }
+    if (!s_get)
+        return false;
+
+    XState st;
+    if (s_user >= 0 && s_get(s_user, &st) != ERROR_SUCCESS)
+        s_user = -1; // unplugged
+    if (s_user < 0)
+    {
+        // looking for a pad is slow when none is connected: only every 2 seconds
+        DWORD now = GetTickCount();
+        if ((int)(now - s_nextScan) < 0)
+            return false;
+        s_nextScan = now + 2000;
+        for (int i = 0; i < 4; i++)
+            if (s_get(i, &st) == ERROR_SUCCESS)
+            {
+                s_user = i;
+                break;
+            }
+        if (s_user < 0)
+            return false;
+    }
+    out->lx = Norm(st.pad.lx);
+    out->ly = Norm(st.pad.ly);
+    out->rx = Norm(st.pad.rx);
+    out->ry = Norm(st.pad.ry);
+    out->lt = st.pad.lt / 255.0f;
+    out->rt = st.pad.rt / 255.0f;
+    out->buttons = st.pad.buttons;
+    return true;
+}
