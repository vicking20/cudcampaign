+#ifdef KISAK_SP
+// COOP: another player's shot (arrives as a fire event on their entity): muzzle flash on the gun
+// held by their body, and a tracer from the muzzle along their aim. The real bullet is simulated
+// by the server on every machine; this only draws it.
+extern float g_coopPlayerPitch[64];
+extern int g_coopBodyEnt;
+static void CG_CoopRemoteFire(int32_t localClientNum, int32_t number, uint32_t weapon, const WeaponDef *weaponDef)
+{
+    int32_t body = number == 0 ? g_coopBodyEnt : number; // player 0 is drawn by a separate body entity
+    if (body < 0)
+        return;
+    centity_s *bodyCent = CG_GetEntity(localClientNum, body);
+    DObj_s *obj = Com_GetClientDObj(body, localClientNum);
+    if (!bodyCent || !obj)
+        return;
+    WeaponFlash(localClientNum, body, weapon, 0, scr_const.tag_flash);
+    if (weaponDef->weapType != WEAPTYPE_BULLET)
+        return;
+    float muzzle[3];
+    if (!CG_DObjGetWorldTagPos(&bodyCent->pose, obj, scr_const.tag_flash, muzzle))
+        return;
+    float ang[3] = { g_coopPlayerPitch[number & 63], bodyCent->nextState.lerp.apos.trBase[1], 0.0f };
+    float fwd[3], end[3];
+    AngleVectors(ang, fwd, 0, 0);
+    Vec3Mad(muzzle, 8192.0f, fwd, end);
+    trace_t tr;
+    CG_LocationalTrace(&tr, muzzle, end, body, MASK_SHOT);
+    float hit[3];
+    Vec3Lerp(muzzle, end, tr.fraction, hit);
+    CG_SpawnTracer(localClientNum, muzzle, hit);
+}
+#endif
