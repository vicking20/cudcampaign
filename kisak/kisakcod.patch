+++ b/src/server/coop_names.h
@@ -0,0 +1,9 @@
+// COOP: the callsigns a player can pick (no free text, so nobody can type something offensive).
+// Shared by the launcher (win32/win_coop_launcher.cpp, passes the index as +set coop_name N) and the
+// engine (server/sv_coop.cpp, sends the index over the network and shows the name in messages).
+#pragma once
+#define COOP_NAME_COUNT 16
+static const char *const kCoopNames[COOP_NAME_COUNT] = {
+    "Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot", "Golf", "Hotel",
+    "India", "Juliet", "Kilo", "Lima", "Mike", "November", "Oscar", "Papa",
+};
diff --git a/src/server/server.h b/src/server/server.h
index 4f5b3ad..f0030a5 100644
--- a/src/server/server.h
+++ b/src/server/server.h
@@ -273,6 +273,19 @@ int __cdecl SV_HistoryIsNew(server_demo_history_t *history);
 void __cdecl SV_ClearInfrequentTimeMarks(server_demo_history_t *history);
 server_demo_history_t *__cdecl SV_DemoGetBuffer();
 server_demo_history_t *__cdecl SV_GetMarkHistory(const char *name);
+
+// COOP: a snapshot of the running game plus the exact position in the recording, so a late guest can
+// start from "now" instead of replaying everything (see sv_demo.cpp / sv_coop.cpp)
+struct CoopSnapshot
+{
+    int time, randomSeed, nextFramePos, msgBit, msgReadcount, readType;
+    usercmd_s lastUsercmd;
+    unsigned char *save, *cm, *freeEnt; // malloc'd copies
+    int saveLen, cmLen, freeLen;
+};
