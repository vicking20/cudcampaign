+// COOP horde mode (+set coop_horde N): survive N waves of enemies on whatever map is loaded. Enemies come out of
+// the map's own enemy spawners and run at the nearest player. Everything runs in the game frame from saved dvars
+// and level.time only, so every machine (and a late guest) does exactly the same thing.
+static bool Coop_HordeIsEnemySpawner(gentity_s *ent)
+{
+    if (!ent->r.inuse || ent->s.eType != ET_ACTOR_SPAWNER || !ent->classname)
+        return false;
+    const char *c = SL_ConvertToString(ent->classname);
+    if (!c)
+        return false;
+    char low[96];
+    int i = 0;
+    for (; c[i] && i < 95; i++)
+        low[i] = (char)tolower((unsigned char)c[i]);
+    low[i] = 0;
+    return strstr(low, "enemy") || strstr(low, "axis") || strstr(low, "opfor") || strstr(low, "opposing");
+}
+
+static int Coop_HordeAliveEnemies()
+{
+    int n = 0;
+    for (actor_s *a = Actor_FirstActor(1 << TEAM_AXIS); a; a = Actor_NextActor(a, 1 << TEAM_AXIS))
+        n++;
+    return n;
+}
+
+static bool Coop_HordeSpawnOne(int salt)
+{
+    int total = level.num_entities;
+    int start = (level.time / 50 + salt * 7) % (total > 0 ? total : 1);
+    for (int tries = 0, idx = start, spawners = 0; tries < total && spawners < 10; tries++, idx = (idx + 1) % total)
+    {
+        gentity_s *sp = &level.gentities[idx];
+        if (!Coop_HordeIsEnemySpawner(sp))
+            continue;
+        spawners++;
+        bool tooClose = false;
+        for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+        {
+            gentity_s *pl = &g_entities[n];
+            if (!pl->r.inuse || !pl->client)
+                continue;
+            float dx = pl->r.currentOrigin[0] - sp->r.currentOrigin[0];
+            float dy = pl->r.currentOrigin[1] - sp->r.currentOrigin[1];
+            if (dx * dx + dy * dy < 400.0f * 400.0f)
+                tooClose = true;
+        }
+        if (tooClose)
+            continue;
+        int savedCount = sp->count;
+        sp->count = 1;
+        s_cloningEnemies = true; // no script hears about it, and no copies are made
+        gentity_s *e = SpawnActor(sp, sp->targetname, CHECK_SPAWN, 1);
+        s_cloningEnemies = false;
+        sp->count = savedCount;
+        if (e && e->actor)
+        {
+            if (e->sentient && e->sentient->eTeam != TEAM_AXIS)
+            {
+                G_FreeEntity(e); // a spawner we mistook for an enemy one
+                continue;
+            }
+            Coop_SendCloneAfterPlayer(e);
+            return true;
+        }
+    }
+    return false;
+}
+
+void Coop_HordeFrame()
+{
+    int waves = Dvar_GetInt("coop_horde");
+    if (waves <= 0 || level.loading || level.changelevel || level.reloadDelayTime)
+        return;
+    int living = 0;
+    for (int n = 0; n < COOP_MAX_CLIENTS; n++)
+    {
+        gentity_s *pl = &g_entities[n];
+        if (pl->r.inuse && pl->client && pl->health > 0 && level.clients[n].ps.pm_type < PM_DEAD)
+            living++;
+    }
+    if (!living)
+        return;
+    int wave = Dvar_GetInt("coop_horde_wave");
+    int left = Dvar_GetInt("coop_horde_left");
+    int next = Dvar_GetInt("coop_horde_next");
+    int deadline = Dvar_GetInt("coop_horde_dl");
+    if (next > level.time + 300000 || deadline > level.time + 300000) // state from before a map change
+    {
+        wave = left = next = deadline = 0;
+        Dvar_SetIntByName("coop_horde_wave", 0);
+        Dvar_SetIntByName("coop_horde_left", 0);
+        Dvar_SetIntByName("coop_horde_dl", 0);
+    }
+    if (!next)
+    {
+        Dvar_SetIntByName("coop_horde_next", level.time + 15000); // time to look around before wave 1
+        return;
+    }
+    if (level.time < next)
+        return;
+    int players = Dvar_GetInt("coop_maxplayers");
+    if (players < 1)
+        players = 1;
+    if (wave == 0 || (left == 0 && (Coop_HordeAliveEnemies() <= 2 || level.time >= deadline)) || level.time >= deadline)
+    {
+        if (wave >= waves)
+        {
+            SV_GameSendServerCommand(-1, "gm \"Horde cleared!\"");
+            Dvar_SetIntByName("coop_horde_wave", 0);
+            Dvar_SetIntByName("coop_horde_next", 0);
+            level.changelevel = 1;
+            level.bMissionSuccess = 1;
+            return;
+        }
+        wave++;
+        left = 5 + 3 * wave + 2 * (players - 1);
+        Dvar_SetIntByName("coop_horde_wave", wave);
+        Dvar_SetIntByName("coop_horde_left", left);
+        Dvar_SetIntByName("coop_horde_dl", level.time + 150000);
+        Dvar_SetIntByName("coop_horde_next", level.time + 4000);
+        SV_GameSendServerCommand(-1, va("gm \"Wave %d of %d\"", wave, waves));
+        return;
+    }
+    if (left > 0)
+    {
+        int cap = 12 + 2 * players;
+        int step = 1000;
+        if (Coop_HordeAliveEnemies() < cap && Coop_HordeSpawnOne(left))
+        {
+            Dvar_SetIntByName("coop_horde_left", left - 1);
+            step = 600;
+        }
+        Dvar_SetIntByName("coop_horde_next", level.time + step);
+        return;
+    }
+    Dvar_SetIntByName("coop_horde_next", level.time + 1000);
+}
