+const int kH = 710, kTop = 40, kShift = 48; // window height; title line; the two extra radio buttons push everything down
+
+struct State
+{
+    bool done, start;
+    HWND single, host, join, hostOnline, joinOnline, map, addr, addrLabel, relayBox, pass, mapLabel, note, win, players, nameBox, diffBox, enemiesBox, wavesBox;
+    HWND lower[20];   // controls under the mission list (they move up when the list is hidden)
+    int lowerY[20], lowerGroup[20], lowerCount; // group 1 = host-only rows (hidden for guests), 2 = below them (move up)
+    char cmd[512];
+};
+State g;
+
+void IniPath(char *out, int n)
+{
+    GetModuleFileNameA(NULL, out, n);
+    char *slash = strrchr(out, '\\');
+    if (slash)
+        *(slash + 1) = 0;
+    strncat(out, "coop_launcher.ini", n - strlen(out) - 1);
+}
+
+bool Checked(HWND h) { return SendMessageA(h, BM_GETCHECK, 0, 0) == BST_CHECKED; }
+
+void UpdateEnabled()
+{
+    bool single = Checked(g.single), host = Checked(g.host), join = Checked(g.join);
+    bool hostOnline = Checked(g.hostOnline), joinOnline = Checked(g.joinOnline);
+    bool hosting = host || hostOnline;          // picks the mission and the game settings
+    bool online = hostOnline || joinOnline;     // goes through a relay
+    EnableWindow(g.addr, join || joinOnline || hostOnline); // an IP address; the room code to join; or the room name to host
+    SetWindowTextA(g.addrLabel, joinOnline ? "Room code:" : hostOnline ? "Room name:" : "Host address:");
+    EnableWindow(g.relayBox, online);
+    EnableWindow(g.pass, !single);
+    for (int i = 0; i < g.lowerCount; i++)
+        if (g.lowerGroup[i] == 1) // only a host chooses players / difficulty / enemies
+            ShowWindow(g.lower[i], hosting ? SW_SHOW : SW_HIDE);
+    EnableWindow(g.map, hosting);
+    // only a host picks the mission; a guest joins whatever the host is playing
+    ShowWindow(g.map, hosting ? SW_SHOW : SW_HIDE);
+    ShowWindow(g.mapLabel, hosting ? SW_SHOW : SW_HIDE);
+    ShowWindow(g.note, hosting ? SW_HIDE : SW_SHOW);
+    {
+        // close the gap left by the hidden mission list (150 tall) and, for a guest, the host-only rows
+        int dy = hosting ? 0 : -100;
+        for (int i = 0; i < g.lowerCount; i++)
+        {
+            RECT r;
+            GetWindowRect(g.lower[i], &r);
+            POINT pt = { r.left, r.top };
+            ScreenToClient(g.win, &pt);
+            int extra = (!hosting && g.lowerGroup[i] == 2) ? -90 : 0;
+            SetWindowPos(g.lower[i], NULL, pt.x, g.lowerY[i] + dy + extra, 0, 0, SWP_NOSIZE | SWP_NOZORDER);
+        }
+        RECT wr;
+        GetWindowRect(g.win, &wr);
+        int h = kH + dy + (hosting ? 0 : -90 + 12); // a little room under the buttons
+        if (wr.bottom - wr.top != h)
+            SetWindowPos(g.win, NULL, 0, 0, wr.right - wr.left, h, SWP_NOMOVE | SWP_NOZORDER);
+    }
+    SetWindowTextA(g.note, joinOnline ? "Enter the room name/code the host gave you and the relay address. You will be taken to the host's mission."
+                         : join ? "You will be taken to whatever mission the host is playing, wherever they are in it."
+                                : "Single player opens the normal main menu.");
+}
+
+void Finish()
+{
+    char map[128] = "cargoship", addr[128], relay[128], pass[64], ini[MAX_PATH], players[8];
+    int nameSel = (int)SendMessageA(g.nameBox, CB_GETCURSEL, 0, 0);
+    if (nameSel < 0 || nameSel >= COOP_NAME_COUNT)
+        nameSel = 0;
+    int diffSel = (int)SendMessageA(g.diffBox, CB_GETCURSEL, 0, 0);
+    int wavesSel = (int)SendMessageA(g.wavesBox, CB_GETCURSEL, 0, 0);
+    static const int kWaveCounts[] = { 0, 5, 10, 15, 20 };
+    if (wavesSel < 0 || wavesSel > 4) wavesSel = 0;
+    int enemiesSel = (int)SendMessageA(g.enemiesBox, CB_GETCURSEL, 0, 0);
+    if (diffSel < 0 || diffSel > 3) diffSel = 1;
+    if (enemiesSel < 0 || enemiesSel > 3) enemiesSel = 0;
+    int pl = (int)SendMessageA(g.players, CB_GETCURSEL, 0, 0);
+    _snprintf(players, sizeof(players), "%d", pl >= 0 ? pl + 2 : 4);
+    int sel = (int)SendMessageA(g.map, LB_GETCURSEL, 0, 0);
+    if (sel >= 0 && sel < kMissionCount && kMissions[sel].map)
+        strncpy(map, kMissions[sel].map, sizeof(map) - 1);
+    GetWindowTextA(g.addr, addr, sizeof(addr));
+    GetWindowTextA(g.relayBox, relay, sizeof(relay));
+    GetWindowTextA(g.pass, pass, sizeof(pass));
+    // spaces would split the launch option
+    for (char *c = addr; *c; ++c) if (*c == ' ') memmove(c, c + 1, strlen(c));
+    for (char *c = relay; *c; ++c) if (*c == ' ') memmove(c, c + 1, strlen(c));
+    for (char *c = pass; *c; ++c) if (*c == ' ' || *c == '"') memmove(c, c + 1, strlen(c)), --c;
+    const char *mode = "single";
+    if (Checked(g.host))
+        mode = "host";
+    else if (Checked(g.join))
+        mode = "join";
+    else if (Checked(g.hostOnline))
+        mode = "hostonline";
+    else if (Checked(g.joinOnline))
+        mode = "joinonline";
+    IniPath(ini, sizeof(ini));
+    WritePrivateProfileStringA("launcher", "mode", mode, ini);
+    WritePrivateProfileStringA("launcher", "map", map, ini);
+    WritePrivateProfileStringA("launcher", "address", addr, ini);
+    WritePrivateProfileStringA("launcher", "relay", relay, ini);
+    WritePrivateProfileStringA("launcher", "password", pass, ini);
+    WritePrivateProfileStringA("launcher", "players", players, ini);
+    char tmp[8];
+    _snprintf(tmp, sizeof(tmp), "%d", diffSel);
+    WritePrivateProfileStringA("launcher", "difficulty", tmp, ini);
+    _snprintf(tmp, sizeof(tmp), "%d", enemiesSel);
+    WritePrivateProfileStringA("launcher", "enemies", tmp, ini);
+    _snprintf(tmp, sizeof(tmp), "%d", wavesSel);
+    WritePrivateProfileStringA("launcher", "waves", tmp, ini);
+    char nameStr[8];
+    _snprintf(nameStr, sizeof(nameStr), "%d", nameSel);
+    WritePrivateProfileStringA("launcher", "name", nameStr, ini);
+
+    char pw[96] = "";
+    if (pass[0])
+        _snprintf(pw, sizeof(pw), " +set coop_password %s", pass);
+    pw[sizeof(pw) - 1] = 0;
+    if (!strcmp(mode, "host"))
+        _snprintf(g.cmd, sizeof(g.cmd), " +set coop_host 1%s +set coop_name %d +set coop_maxplayers %s +set coop_difficulty %d +set coop_enemies %d +set coop_horde %d +set coop_autostart 1 +set com_introPlayed 1 " kQuiet " +map %s", pw, nameSel, players, diffSel, enemiesSel + 1, kWaveCounts[wavesSel], map);
+    else if (!strcmp(mode, "join") && addr[0])
+        // the guest's own map is only a starting point: the host tells it which map to load
+        _snprintf(g.cmd, sizeof(g.cmd), " +set coop_connect %s%s +set coop_name %d +set coop_autostart 1 +set com_introPlayed 1 " kQuiet " +map cargoship", addr, pw, nameSel);
+    else if (!strcmp(mode, "hostonline") && relay[0])
+        // through the relay: nothing listens on this machine; the game prints the room code to give your friends
+        _snprintf(g.cmd, sizeof(g.cmd), " +set coop_host 1 +set coop_relay %s%s%s%s +set coop_name %d +set coop_maxplayers %s +set coop_difficulty %d +set coop_enemies %d +set coop_horde %d +set coop_autostart 1 +set com_introPlayed 1 " kQuiet " +map %s", relay, addr[0] ? " +set coop_roomname " : "", addr, pw, nameSel, players, diffSel, enemiesSel + 1, kWaveCounts[wavesSel], map);
+    else if (!strcmp(mode, "joinonline") && relay[0] && addr[0])
+        _snprintf(g.cmd, sizeof(g.cmd), " +set coop_connect %s@%s%s +set coop_name %d +set coop_autostart 1 +set com_introPlayed 1 " kQuiet " +map cargoship", addr, relay, pw, nameSel);
+    else
+        g.cmd[0] = 0; // single player: the normal main menu
+    g.cmd[sizeof(g.cmd) - 1] = 0;
+    g.start = true;
+    g.done = true;
+}
+
+LRESULT CALLBACK LauncherProc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    switch (m)
+    {
+    case WM_COMMAND:
+        switch (LOWORD(w))
+        {
+        case ID_SINGLE: case ID_HOST: case ID_JOIN: case ID_HOSTONLINE: case ID_JOINONLINE: UpdateEnabled(); return 0;
+        case ID_MAP:
+            if (HIWORD(w) == LBN_SELCHANGE)
+            {
+                int sel = (int)SendMessageA(g.map, LB_GETCURSEL, 0, 0);
+                if (sel >= 0 && sel < kMissionCount && !kMissions[sel].map && sel + 1 < kMissionCount)
+                    SendMessageA(g.map, LB_SETCURSEL, sel + 1, 0); // an act heading: take the first mission under it
+            }
+            return 0;
+        case ID_START: Finish(); return 0;
+        case ID_QUIT: g.done = true; return 0;
+        }
+        break;
+    case WM_CLOSE: g.done = true; return 0;
+    }
+    return DefWindowProcA(h, m, w, l);
+}
+
+HWND Add(HWND parent, const char *cls, const char *text, DWORD style, int x, int y, int w, int h, int id, HFONT font)
+{
+    HWND c = CreateWindowExA(0, cls, text, WS_CHILD | WS_VISIBLE | style, x, y + kTop + (y >= 130 && (id == 0 || id >= ID_MAP) ? kShift : 0), w, h, parent, (HMENU)(INT_PTR)id, GetModuleHandleA(NULL), NULL);
+    SendMessageA(c, WM_SETFONT, (WPARAM)font, TRUE);
+    return c;
+}
+} // namespace
+
+// Returns false if the user chose Quit. Appends the chosen launch options to cmdline.
+bool Coop_ShowLauncher(char *cmdline, int cmdlineSize)
+{
+    WNDCLASSA wc = {};
+    wc.lpfnWndProc = LauncherProc;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    wc.lpszClassName = "KisakCoopLauncher";
+    RegisterClassA(&wc);
+
+    int W = 420, H = kH;
+    int sx = (GetSystemMetrics(SM_CXSCREEN) - W) / 2, sy = (GetSystemMetrics(SM_CYSCREEN) - H) / 2;
+    // borderless window (no title bar): the title line below stands in for it
+    HWND win = CreateWindowExA(WS_EX_TOPMOST, wc.lpszClassName, "CudCampaign",
+        WS_POPUP | WS_DLGFRAME | WS_VISIBLE, sx, sy, W, H, NULL, NULL, wc.hInstance, NULL);
+    g.win = win;
+    HFONT titleFont = CreateFontA(24, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0, 0, 0, "Arial");
+    HFONT font = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
+
+    char ini[MAX_PATH], mode[16], map[128], addr[128], relay[128], pass[64];
+    int savedPlayers;
+    IniPath(ini, sizeof(ini));
+    GetPrivateProfileStringA("launcher", "mode", "single", mode, sizeof(mode), ini);
+    GetPrivateProfileStringA("launcher", "map", "cargoship", map, sizeof(map), ini);
+    GetPrivateProfileStringA("launcher", "address", "", addr, sizeof(addr), ini);
+    GetPrivateProfileStringA("launcher", "relay", "", relay, sizeof(relay), ini);
+    GetPrivateProfileStringA("launcher", "password", "", pass, sizeof(pass), ini);
+    savedPlayers = GetPrivateProfileIntA("launcher", "players", 4, ini);
+
+    {
+        HWND t = CreateWindowExA(0, "STATIC", "CUDCAMPAIGN", WS_CHILD | WS_VISIBLE | SS_CENTER, 0, 8, W - 6, 28, win, NULL, wc.hInstance, NULL);
+        SendMessageA(t, WM_SETFONT, (WPARAM)titleFont, TRUE);
+    }
+    Add(win, "STATIC", "Start the host first; guests join whatever the host is playing.", 0, 16, 4, 380, 20, 0, font);
+    g.single = Add(win, "BUTTON", "Single player (main menu)", BS_AUTORADIOBUTTON | WS_GROUP, 16, 50, 380, 20, ID_SINGLE, font);
+    g.host = Add(win, "BUTTON", "Host a co-op game (LAN / direct IP)", BS_AUTORADIOBUTTON, 16, 74, 380, 20, ID_HOST, font);
+    g.join = Add(win, "BUTTON", "Join a co-op game (IP address)", BS_AUTORADIOBUTTON, 16, 98, 380, 20, ID_JOIN, font);
+    g.hostOnline = Add(win, "BUTTON", "Host online (through a relay, room code)", BS_AUTORADIOBUTTON, 16, 122, 380, 20, ID_HOSTONLINE, font);
+    g.joinOnline = Add(win, "BUTTON", "Join online (room code)", BS_AUTORADIOBUTTON, 16, 146, 380, 20, ID_JOINONLINE, font);
+    g.mapLabel = Add(win, "STATIC", "Mission:", 0, 16, 130, 200, 18, 0, font);
+    g.note = Add(win, "STATIC", "", 0, 16, 150, 384, 60, 0, font);
+    g.map = Add(win, "LISTBOX", "", WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT, 16, 150, 384, 150, ID_MAP, font);
+    int selIdx = -1;
+    for (int i = 0; i < kMissionCount; i++)
+    {
+        char line[160];
+        if (kMissions[i].map)
+            _snprintf(line, sizeof(line), "   %s   (%s)", kMissions[i].title, kMissions[i].map);
+        else
+            _snprintf(line, sizeof(line), "%s", kMissions[i].title);
+        line[sizeof(line) - 1] = 0;
+        SendMessageA(g.map, LB_ADDSTRING, 0, (LPARAM)line);
+        if (kMissions[i].map && !strcmp(kMissions[i].map, map))
+            selIdx = i;
+    }
+    SendMessageA(g.map, LB_SETCURSEL, selIdx >= 0 ? selIdx : 3, 0);
+    struct { const char *cls, *text; DWORD style; int x, y, w, h, id; HWND *out; int group; } lowerDefs[] = {
+        { "STATIC", "Host address:", 0, 16, 318, 90, 18, 0, &g.addrLabel, 0 },
+        { "EDIT", addr, WS_BORDER | ES_AUTOHSCROLL, 110, 314, 200, 22, ID_ADDR, &g.addr, 0 },
+        { "STATIC", "Relay:", 0, 16, 348, 90, 18, 0, 0, 0 },
+        { "EDIT", relay, WS_BORDER | ES_AUTOHSCROLL, 110, 344, 200, 22, ID_RELAY, &g.relayBox, 0 },
+        { "STATIC", "Password:", 0, 16, 378, 90, 18, 0, 0, 0 },
+        { "EDIT", pass, WS_BORDER | ES_AUTOHSCROLL, 110, 374, 200, 22, ID_PASS, &g.pass, 0 },
+        { "STATIC", "Your name:", 0, 16, 408, 90, 18, 0, 0, 0 },
+        { "COMBOBOX", "", CBS_DROPDOWNLIST | WS_VSCROLL, 110, 404, 130, 160, ID_NAME, &g.nameBox, 0 },
+        { "STATIC", "Players:", 0, 16, 438, 90, 18, 0, 0, 1 },
+        { "COMBOBOX", "", CBS_DROPDOWNLIST | WS_VSCROLL, 110, 434, 70, 120, ID_PLAYERS, &g.players, 1 },
+        { "STATIC", "Difficulty:", 0, 16, 468, 90, 18, 0, 0, 1 },
+        { "COMBOBOX", "", CBS_DROPDOWNLIST | WS_VSCROLL, 110, 464, 130, 120, ID_DIFF, &g.diffBox, 1 },
+        { "STATIC", "Enemies:", 0, 16, 498, 90, 18, 0, 0, 1 },
+        { "COMBOBOX", "", CBS_DROPDOWNLIST | WS_VSCROLL, 110, 494, 130, 120, ID_ENEMIES, &g.enemiesBox, 1 },
+        { "STATIC", "Horde waves:", 0, 16, 528, 90, 18, 0, 0, 1 },
+        { "COMBOBOX", "", CBS_DROPDOWNLIST | WS_VSCROLL, 110, 524, 130, 120, ID_WAVES, &g.wavesBox, 1 },
+        { "STATIC", "Leave the password empty for an open game.", 0, 16, 558, 384, 18, 0, 0, 2 },
+        { "BUTTON", "Start", BS_DEFPUSHBUTTON, 110, 582, 90, 28, ID_START, 0, 2 },
+        { "BUTTON", "Quit", 0, 220, 582, 90, 28, ID_QUIT, 0, 2 },
+    };
+    g.lowerCount = 0;
+    for (auto &d : lowerDefs)
+    {
+        HWND c = Add(win, d.cls, d.text, d.style, d.x, d.y, d.w, d.h, d.id, font);
+        if (d.out)
+            *d.out = c;
+        g.lower[g.lowerCount] = c;
+        g.lowerGroup[g.lowerCount] = d.group;
+        g.lowerY[g.lowerCount++] = d.y + kTop + kShift;
+    }
+
+    for (int i = 0; i < COOP_NAME_COUNT; i++)
+        SendMessageA(g.nameBox, CB_ADDSTRING, 0, (LPARAM)kCoopNames[i]);
+    {
+        int saved = GetPrivateProfileIntA("launcher", "name", 0, ini);
+        SendMessageA(g.nameBox, CB_SETCURSEL, saved >= 0 && saved < COOP_NAME_COUNT ? saved : 0, 0);
+    }
+    static const char *kCounts[] = { "2", "3", "4" };
+    for (const char *n : kCounts)
+        SendMessageA(g.players, CB_ADDSTRING, 0, (LPARAM)n);
+    SendMessageA(g.players, CB_SETCURSEL, savedPlayers >= 2 && savedPlayers <= 4 ? savedPlayers - 2 : 2, 0);
+    static const char *kDiffs[] = { "Recruit", "Regular", "Hardened", "Veteran" };
+    for (const char *d : kDiffs)
+        SendMessageA(g.diffBox, CB_ADDSTRING, 0, (LPARAM)d);
+    SendMessageA(g.diffBox, CB_SETCURSEL, GetPrivateProfileIntA("launcher", "difficulty", 1, ini) & 3, 0);
+    static const char *kEnemies[] = { "Normal", "Double", "Triple", "Quadruple" };
+    for (const char *e : kEnemies)
+        SendMessageA(g.enemiesBox, CB_ADDSTRING, 0, (LPARAM)e);
+    SendMessageA(g.enemiesBox, CB_SETCURSEL, GetPrivateProfileIntA("launcher", "enemies", 0, ini) & 3, 0);
+    static const char *kWaves[] = { "Off (campaign)", "5 waves", "10 waves", "15 waves", "20 waves" };
+    for (const char *w : kWaves)
+        SendMessageA(g.wavesBox, CB_ADDSTRING, 0, (LPARAM)w);
+    SendMessageA(g.wavesBox, CB_SETCURSEL, GetPrivateProfileIntA("launcher", "waves", 0, ini) % 5, 0);
+    int sel = !strcmp(mode, "host") ? ID_HOST : !strcmp(mode, "join") ? ID_JOIN : !strcmp(mode, "hostonline") ? ID_HOSTONLINE : !strcmp(mode, "joinonline") ? ID_JOINONLINE : ID_SINGLE;
+    CheckRadioButton(win, ID_SINGLE, ID_JOINONLINE, sel);
+    g.done = g.start = false;
+    UpdateEnabled();
+    SetForegroundWindow(win);
+
+    MSG msg;
+    while (!g.done && GetMessageA(&msg, NULL, 0, 0) > 0)
+    {
+        if (!IsDialogMessageA(win, &msg))
+        {
+            TranslateMessage(&msg);
+            DispatchMessageA(&msg);
+        }
+    }
+    DestroyWindow(win);
+    if (!g.start)
+        return false;
+    strncat(cmdline, g.cmd, cmdlineSize - strlen(cmdline) - 1);
+    return true;
+}
