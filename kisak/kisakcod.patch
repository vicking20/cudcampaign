+        const dvar_s *cmd = Dvar_FindVar("coop_autocmd");
+        const dvar_s *at = Dvar_FindVar("coop_autocmd_time");
+        int atMs = at ? (int)(atof(Dvar_DisplayableValue(at)) * 1000.0f) : 10000;
+        if (cmd && *Dvar_DisplayableValue(cmd) && now > atMs)
+        {
+            autoCmdDone = 1;
+            Com_Printf(CON_CHANNEL_SERVER, "COOP: autocmd '%s' at %d ms\n", Dvar_DisplayableValue(cmd), now);
+            Cbuf_AddText(0, va("%s\n", Dvar_DisplayableValue(cmd)));
+        }
+    }
+
