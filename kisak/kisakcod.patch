+// COOP: take a snapshot of the game as it is right now (host, between frames). Uses the same machinery
+// as the "replay_mark" command, then copies the result out so nothing depends on the history buffers.
+bool SV_CoopTakeSnapshot(CoopSnapshot *o)
+{
+    memset(o, 0, sizeof(*o));
+    if (!sv.demo.recording || !sv.demo.msg.data)
+        return false;
+    if (!SV_GetMarkHistory("coopjoin"))
+        return false;
+    SV_FreeHistoryData(g_history);
+    server_demo_history_t *h = g_history;
+    bool ok = SV_DemoSaveHistory(h) != 0 && h->save.buf && h->cmBuf && h->freeEntBuf;
+    if (ok)
+    {
+        o->time = h->time;
+        o->randomSeed = h->randomSeed;
+        o->nextFramePos = h->nextFramePos;
+        o->msgBit = h->msgBit;
+        o->msgReadcount = h->msgReadcount;
+        o->readType = h->readType;
+        memcpy(&o->lastUsercmd, &h->lastUsercmd, sizeof(o->lastUsercmd));
+        o->saveLen = h->save.bufLen;
+        o->cmLen = h->cmBufLen;
+        o->freeLen = h->freeEntBufLen;
+        o->save = (unsigned char *)malloc(o->saveLen);
+        o->cm = (unsigned char *)malloc(o->cmLen);
+        o->freeEnt = (unsigned char *)malloc(o->freeLen);
+        memcpy(o->save, h->save.buf, o->saveLen);
+        memcpy(o->cm, h->cmBuf, o->cmLen);
+        memcpy(o->freeEnt, h->freeEntBuf, o->freeLen);
+        // the free-entity list holds raw gentity addresses, valid only inside this process: send entity
+        // numbers (+1, 0 = none) instead, the guest turns them back into its own addresses
+        unsigned int *w = (unsigned int *)o->freeEnt;
+        for (int i = 0; i < o->freeLen / 4; i++)
+            if (w[i])
+                w[i] = (unsigned int)((gentity_s *)(uintptr_t)w[i] - g_entities) + 1;
+    }
+    SV_FreeHistoryData(g_history);
+    g_history = 0;
+    if (!ok)
+        SV_CoopFreeSnapshot(o);
+    return ok;
+}
+
+void SV_CoopFreeSnapshot(CoopSnapshot *s)
+{
+    free(s->save);
+    free(s->cm);
+    free(s->freeEnt);
+    memset(s, 0, sizeof(*s));
+}
+
+// COOP (guest): make the next replay start from a host snapshot. The history object and its buffers
+// are ours (plain malloc), owned until the next snapshot replaces them.
+bool SV_CoopInstallSnapshot(const CoopSnapshot *s)
+{
+    static server_demo_history_t hist;
+    free(hist.save.buf);
+    free(hist.cmBuf);
+    free(hist.freeEntBuf);
+    memset(&hist, 0, sizeof(hist));
+    hist.time = s->time;
+    hist.randomSeed = s->randomSeed;
+    hist.nextFramePos = s->nextFramePos;
+    hist.msgBit = s->msgBit;
+    hist.msgReadcount = s->msgReadcount;
+    hist.readType = s->readType;
+    memcpy(&hist.lastUsercmd, &s->lastUsercmd, sizeof(hist.lastUsercmd));
+    hist.save.buf = (unsigned char *)malloc(s->saveLen);
+    hist.save.bufLen = s->saveLen;
+    hist.cmBuf = (unsigned char *)malloc(s->cmLen);
+    hist.cmBufLen = s->cmLen;
+    hist.freeEntBuf = (unsigned char *)malloc(s->freeLen);
+    hist.freeEntBufLen = s->freeLen;
+    memcpy(hist.save.buf, s->save, s->saveLen);
+    memcpy(hist.cmBuf, s->cm, s->cmLen);
+    memcpy(hist.freeEntBuf, s->freeEnt, s->freeLen);
+    unsigned int *w = (unsigned int *)hist.freeEntBuf; // entity numbers (+1) back to this process's addresses
+    for (int i = 0; i < s->freeLen / 4; i++)
+        if (w[i])
+            w[i] = w[i] - 1 < MAX_GENTITIES ? (unsigned int)(uintptr_t)&g_entities[w[i] - 1] : 0;
+    sv.demo.nextLevelSave = &hist;
+    sv.demo.nextLevelTime = 0;
+    return true;
+}
