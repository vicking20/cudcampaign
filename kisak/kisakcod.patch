+// COOP: other players' bodies look up/down by bending the upper spine by their view pitch.
+// coop_aim_axis (0/1/2) and coop_aim_scale pick the bone axis and amount (tuned by eye).
+extern float g_coopPlayerPitch[64];
+extern float g_coopPlayerLean[64];
+extern int g_coopBodyEnt;
+static void CG_CoopPlayer_DoControllers(const cpose_t *pose, const DObj_s *obj, int *partBits)
+{
+    static unsigned int spineName;
+    if (!spineName)
+        spineName = SL_FindString("j_spineupper");
+    unsigned char bone;
+    if (!spineName || !DObjGetBoneIndex(obj, spineName, &bone))
+        return;
+    const centity_s *cent = (const centity_s *)pose; // pose is the first member of centity_s
+    float pitch = g_coopPlayerPitch[cent->nextState.number & 63];
+    if (pitch > 180.0f)
+        pitch -= 360.0f;
+    const dvar_s *axisVar = Dvar_FindVar("coop_aim_axis");
+    const dvar_s *scaleVar = Dvar_FindVar("coop_aim_scale");
+    int axis = axisVar ? atoi(Dvar_DisplayableValue(axisVar)) : 0;
+    float scale = (scaleVar && *Dvar_DisplayableValue(scaleVar)) ? (float)atof(Dvar_DisplayableValue(scaleVar)) : 1.0f;
+    float angles[3] = { 0.0f, 0.0f, 0.0f };
+    angles[(axis >= 0 && axis < 3) ? axis : 0] = pitch * scale;
+    // lean (Q/E): tilt the upper body sideways. coop_lean_axis / coop_lean_scale (degrees at full lean)
+    const dvar_s *leanAxisVar = Dvar_FindVar("coop_lean_axis");
+    const dvar_s *leanScaleVar = Dvar_FindVar("coop_lean_scale");
+    int leanAxis = (leanAxisVar && *Dvar_DisplayableValue(leanAxisVar)) ? atoi(Dvar_DisplayableValue(leanAxisVar)) : 2;
+    float leanScale = (leanScaleVar && *Dvar_DisplayableValue(leanScaleVar)) ? (float)atof(Dvar_DisplayableValue(leanScaleVar)) : 25.0f;
+    angles[(leanAxis >= 0 && leanAxis < 3) ? leanAxis : 2] += g_coopPlayerLean[cent->nextState.number & 63] * leanScale;
+    DObjSetControlTagAngles((DObj_s *)obj, partBits, bone, angles);
+}
+
 void __cdecl CG_DoControllers(const cpose_t *pose, const DObj_s *obj, int *partBits)
 {
     int setPartBits[4];
@@ -354,6 +386,13 @@ void __cdecl CG_DoControllers(const cpose_t *pose, const DObj_s *obj, int *partB
     case ET_ACTOR_CORPSE:
         CG_Actor_DoControllers(pose, obj, partBits);
         break;
+    case ET_PLAYER: // COOP
+        CG_CoopPlayer_DoControllers(pose, obj, partBits);
+        break;
+    case ET_GENERAL: // COOP: player 0's body entity
+        if (((const centity_s *)pose)->nextState.number == g_coopBodyEnt)
+            CG_CoopPlayer_DoControllers(pose, obj, partBits);
